    "vela.toml": "[package]\nid='dev.vela.references'\nname='references'\nversion='0.1.0'\n[source]\nroots=['scripts']\n",
    "scripts/main.vela": "/* 中😀 */ use helpers::[[import:start]]grant[[import:end]];\nfn main([[param-decl:start]]amount[[param-decl:end]]: i64) -> i64 {\n    /* 中😀 */ let [[local-decl:start]]value[[local-decl:end]] = [[param-read:start]]amount[[param-read:end]];\n    /* 中😀 */ [[local-write:start]]value[[local-write:end]] += [[param-rhs:start]]amount[[param-rhs:end]];\n    { let [[shadow-decl:start]]value[[shadow-decl:end]] = 7; [[shadow-read:start]]value[[shadow-read:end]]; }\n    /* 中😀 */ [[call-one:start]]grant[[call-one:end]]([[local-read:start]]value[[local-read:end]]);\n    /* 中😀 */ return helpers::[[call-two:start]]grant[[call-two:end]]([[param-call:start]]amount[[param-call:end]]);\n}\nfn negative() { /* 中😀 */ [[unknown:start]]missing[[unknown:end]]; let note = \"[[literal:start]]grant[[literal:end]]\"; }\n// [[comment:start]]grant[[comment:end]]\n[[keyword:start]]fn[[keyword:end]] other() {}\n",
    "scripts/helpers.vela": "/* 中😀 */ pub fn [[function-decl:start]]grant[[function-decl:end]](seed: i64) -> i64 { return seed; }\n",
    "scripts/consumer.vela": "/* 中😀 */ fn side() { helpers::[[call-other:start]]grant[[call-other:end]](0); }\n"
