    "vela.toml": "[package]\nid = \"dev.vela.default_bindings\"\nname = \"default_bindings\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "scripts/helpers.vela": "const [[constant-decl:start]]value[[constant-decl:end]]: i64 = 10;\n/* 中😀 */ pub enum Event { Item([[field-decl:start]]value[[field-decl:end]]: i64, spare: i64 = { let [[tuple-local-decl:start]]temp[[tuple-local-decl:end]] = 1; [[tuple-local-write:start]]temp[[tuple-local-write:end]] += 1; [[first-default:start]]value[[first-default:end]] + [[tuple-local-use:start]]temp[[tuple-local-use:end]] }, extra: i64 = (|| [[second-default:start]]value[[second-default:end]])()), Other([[other-decl:start]]value[[other-decl:end]]: i64) }\npub trait Measure { fn measure(self, amount: i64, spare: i64 = { let [[trait-local-decl:start]]temp[[trait-local-decl:end]] = 2; [[trait-local-write:start]]temp[[trait-local-write:end]] += 1; amount + [[trait-local-use:start]]temp[[trait-local-use:end]] }, extra: i64 = [[trait-default:start]]value[[trait-default:end]]) -> i64; }\nconst mirror: i64 = [[const-initializer:start]]value[[const-initializer:end]];\nstate stored: i64 = [[state-initializer:start]]value[[state-initializer:end]];\npub struct Holder {}\nimpl Holder { fn read(self) -> i64 { return [[method-use:start]]value[[method-use:end]]; } }\npub trait Readable { fn read(self) -> i64 { return [[trait-body:start]]value[[trait-body:end]]; } }\nfn regular(arg: i64 = [[function-default:start]]value[[function-default:end]]) {}\n",
    "scripts/consumer.vela": "/* 中😀 */ fn closed() { helpers::Event::Item([[closed-label:start]]value[[closed-label:end]] = 3); }\n",
    "scripts/main.vela": "use helpers::Event::Item as ItemAlias\n/* 中😀 */ fn main([[caller-decl:start]]value[[caller-decl:end]]: i64) {\n ItemAlias([[main-label:start]]value[[main-label:end]] = [[caller-use:start]]value[[caller-use:end]]);\n let call = || helpers::Event::Item([[closure-label:start]]value[[closure-label:end]] = 4);\n helpers::Event::Other([[other-label:start]]value[[other-label:end]] = 5);\n helpers::Event::Item([[unknown-label:start]]bogus[[unknown-label:end]] = 6);\n Missing::Item([[unknown-owner:start]]value[[unknown-owner:end]] = 7);\n let note = \"[[literal:start]]value[[literal:end]]\";\n}\n"
