  "id": "reference-rename-schema-type-imports",
  "files": {
    "vela.toml": "[package]\nid = \"dev.vela.schema_types\"\nname = \"schema_types\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"target/schema.json\"\n",
    "scripts/helpers.vela": "/* 中😀 */ pub struct [[parcel-decl:start]]Parcel[[parcel-decl:end]] { value: i64 }\npub enum [[mode-decl:start]]Mode[[mode-decl:end]] { Idle }\npub trait [[trait-decl:start]]Readable[[trait-decl:end]] { fn read(self) -> i64; }\n",
    "scripts/main.vela": "/* 中😀 */ use host::[[parcel-terminal:start]]Parcel[[parcel-terminal:end]] as [[parcel-alias:start]]Boxed[[parcel-alias:end]];\nuse host::[[mode-terminal:start]]Mode[[mode-terminal:end]] as [[mode-alias:start]]Stage[[mode-alias:end]];\nuse host::[[trait-terminal:start]]Readable[[trait-terminal:end]] as [[trait-alias:start]]R[[trait-alias:end]];\nuse host::[[opaque-terminal:start]]Opaque[[opaque-terminal:end]] as [[opaque-alias:start]]Ghost[[opaque-alias:end]];\nfn inspect(value: [[parcel-param:start]]Boxed[[parcel-param:end]], mode: [[mode-param:start]]Stage[[mode-param:end]], rule: [[trait-param:start]]R[[trait-param:end]], ghost: [[opaque-param:start]]Ghost[[opaque-param:end]]) -> [[parcel-return:start]]Boxed[[parcel-return:end]] { return value; }\nstruct MainLocal { value: i64 }\nimpl [[trait-impl-alias:start]]R[[trait-impl-alias:end]] for MainLocal { fn read(self) -> i64 { return self.value; } }\n",
    "scripts/consumer.vela": "/* 中😀 */ fn consume(value: host::[[parcel-consumer:start]]Parcel[[parcel-consumer:end]], mode: host::[[mode-consumer:start]]Mode[[mode-consumer:end]], rule: host::[[trait-consumer:start]]Readable[[trait-consumer:end]]) -> host::[[parcel-consumer-return:start]]Parcel[[parcel-consumer-return:end]] { return value; }\nstruct ConsumerLocal { value: i64 }\nimpl host::[[trait-impl-qualified:start]]Readable[[trait-impl-qualified:end]] for ConsumerLocal { fn read(self) -> i64 { return self.value; } }\n",
    "scripts/module.vela": "/* 中😀 */ use host as h;\nfn via_module(value: h::[[parcel-module:start]]Parcel[[parcel-module:end]], mode: h::[[mode-module:start]]Mode[[mode-module:end]], rule: h::[[trait-module:start]]Readable[[trait-module:end]]) -> h::[[parcel-module-return:start]]Parcel[[parcel-module-return:end]] { return value; }\nstruct ModuleLocal { value: i64 }\nimpl h::[[trait-impl-module:start]]Readable[[trait-impl-module:end]] for ModuleLocal { fn read(self) -> i64 { return self.value; } }\n",
    "scripts/direct.vela": "/* 中😀 */ use host::[[parcel-direct-terminal:start]]Parcel[[parcel-direct-terminal:end]];\nfn direct(value: [[parcel-direct-use:start]]Parcel[[parcel-direct-use:end]]) -> [[parcel-direct-return:start]]Parcel[[parcel-direct-return:end]] { return value; }\n",
    "scripts/missing.vela": "/* 中😀 */ use absent::[[missing-terminal:start]]Parcel[[missing-terminal:end]] as Unknown;\nfn missing(value: [[missing-use:start]]Unknown[[missing-use:end]]) {}\n"
  },
