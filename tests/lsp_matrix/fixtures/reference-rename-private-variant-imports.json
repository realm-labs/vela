  "id": "reference-rename-private-variant-imports",
  "files": {
    "vela.toml": "[package]\nid = \"dev.vela.schema_variants\"\nname = \"schema_variants\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"target/schema.json\"\n",
    "scripts/helpers.vela": "/* 中😀 */ pub fn [[decl:start]]Active[[decl:end]]() {}\n",
    "scripts/main.vela": "fn main() {\n /* 中😀 */ match host::State::[[scrutinee:start]]Active[[scrutinee:end]] { host::State::[[inline-pattern:start]]Active[[inline-pattern:end]] => { let next = host::State::[[arm-value:start]]Active[[arm-value:end]]; } peer::State::[[peer-pattern:start]]Active[[peer-pattern:end]] => {} }\n match peer::State::[[peer-value:start]]Active[[peer-value:end]] {\n host::State::[[split-pattern:start]]Active[[split-pattern:end]]\n => {}\n }\n let value = host::State::[[comment-value:start]]Active[[comment-value:end]]; // => [[comment:start]]Active[[comment:end]]\n let unknown = missing::State::[[unknown:start]]Active[[unknown:end]];\n let text = \"[[literal:start]]Active[[literal:end]] =>\";\n}\n",
    "scripts/consumer.vela": "fn closed() { let v = host::State::[[closed:start]]Active[[closed:end]];\n match meta::State::[[meta-value:start]]Active[[meta-value:end]] { meta::State::[[meta-pattern:start]]Active[[meta-pattern:end]] => {} }\n}\n",
    "scripts/imports.vela": "use host as bridge;\nuse host::State as Status;\nuse host::State::[[direct-import:start]]Active[[direct-import:end]];\nuse host::State::[[alias-path:start]]Active[[alias-path:end]] as [[alias-decl:start]]Selected[[alias-decl:end]];\nuse meta::State as Metadata;\nfn imported() {\n let a = bridge::State::[[module-value:start]]Active[[module-value:end]];\n match Status::[[enum-value:start]]Active[[enum-value:end]] { Status::[[enum-pattern:start]]Active[[enum-pattern:end]] => {} }\n let b = [[direct-value:start]]Active[[direct-value:end]];\n let c = [[alias-value:start]]Selected[[alias-value:end]];\n let d = Metadata::[[meta-alias:start]]Active[[meta-alias:end]];\n}\nfn source_owner() { let x = shadow::State::[[source-qualified:start]]Active[[source-qualified:end]]; }\nfn local_alias([[local-decl:start]]Selected[[local-decl:end]]) { let x = [[local-value:start]]Selected[[local-value:end]]; }\n",
    "scripts/shadow.vela": "/* 中😀 */ pub enum [[source-type:start]]State[[source-type:end]] { [[source-decl:start]]Active[[source-decl:end]], Done }\nfn own() { let x = State::[[source-value:start]]Active[[source-value:end]]; match x { State::[[source-pattern:start]]Active[[source-pattern:end]] => {} } }\n",
    "scripts/source_imports.vela": "/* 中😀 */ use shadow::State::[[source-import:start]]Active[[source-import:end]];\nuse shadow::State::[[source-alias-path:start]]Active[[source-alias-path:end]] as [[source-alias:start]]SourceActive[[source-alias:end]];\nuse shadow::State as SourceState;\nfn source_imports() {\n let a = [[source-direct:start]]Active[[source-direct:end]];\n let b = [[source-alias-value:start]]SourceActive[[source-alias-value:end]];\n match SourceState::[[source-type-value:start]]Active[[source-type-value:end]] { SourceState::[[source-type-pattern:start]]Active[[source-type-pattern:end]] => {} }\n}\nuse shadow::State::[[missing-import:start]]Phantom[[missing-import:end]] as PhantomAlias;\nuse hidden_defs::Hidden::[[private-import:start]]Active[[private-import:end]] as HiddenActive;\nfn invalid() { let x = [[missing-use:start]]PhantomAlias[[missing-use:end]]; let y = [[private-use:start]]HiddenActive[[private-use:end]]; }\nfn local_alias([[local-alias-decl:start]]SourceActive[[local-alias-decl:end]]) { let x = [[local-alias-use:start]]SourceActive[[local-alias-use:end]]; }\n",
    "scripts/hidden_defs.vela": "enum Hidden { Active }\n",
    "scripts/secret_defs.vela": "/* 中😀 */ enum Secret { [[private-decl:start]]Active[[private-decl:end]], Other }\nuse secret_defs::Secret::[[private-direct-import:start]]Active[[private-direct-import:end]];\nuse secret_defs::Secret::[[private-alias-path:start]]Active[[private-alias-path:end]] as [[private-alias:start]]Kept[[private-alias:end]];\nuse secret_defs::Secret as SecretAlias;\nfn private_uses() {\n let a = [[private-direct-use:start]]Active[[private-direct-use:end]];\n let b = [[private-alias-use:start]]Kept[[private-alias-use:end]];\n match SecretAlias::[[private-type-use:start]]Active[[private-type-use:end]] { SecretAlias::[[private-type-pattern:start]]Active[[private-type-pattern:end]] => {} }\n}\nfn local_alias([[private-local-decl:start]]Kept[[private-local-decl:end]]) { let x = [[private-local-use:start]]Kept[[private-local-use:end]]; }\nfn captured(Shadowed) { let x = [[private-captured:start]]Active[[private-captured:end]]; }\nfn unresolved() { let x = secret_defs::Secret::[[private-unknown:start]]Unresolved[[private-unknown:end]]; }\n"
  },
