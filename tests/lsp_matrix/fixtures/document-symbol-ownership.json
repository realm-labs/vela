    "scripts/source.vela": "/* 中😀 */ [[widget-range:start]]pub struct [[widget-name:start]]Widget[[widget-name:end]] { [[value-range:start]][[value-name:start]]value[[value-name:end]]: i64 = 1[[value-range:end]], [[other-range:start]][[other-name:start]]other[[other-name:end]]: Any[[other-range:end]] }[[widget-range:end]]\n[[choice-range:start]]pub enum [[choice-name:start]]Choice[[choice-name:end]] { [[empty-range:start]][[empty-name:start]]Empty[[empty-name:end]][[empty-range:end]], [[pair-range:start]][[pair-name:start]]Pair[[pair-name:end]]([[pair-value-range:start]][[pair-value-name:start]]value[[pair-value-name:end]]: i64[[pair-value-range:end]])[[pair-range:end]], [[named-range:start]][[named-name:start]]Named[[named-name:end]] { [[named-value-range:start]][[named-value-name:start]]value[[named-value-name:end]]: i64[[named-value-range:end]] }[[named-range:end]] }[[choice-range:end]]\n[[readable-range:start]]pub trait [[readable-name:start]]Readable[[readable-name:end]] { [[required-range:start]]fn [[required-name:start]]read[[required-name:end]](self) -> i64;[[required-range:end]] [[default-range:start]]fn [[default-name:start]]preview[[default-name:end]](self, value: i64 = 2) -> i64 { return value; }[[default-range:end]] }[[readable-range:end]]\n[[inherent-range:start]][[inherent-name:start]]impl Widget[[inherent-name:end]] { [[method-range:start]]fn [[method-name:start]]read[[method-name:end]](self) -> i64 { return self.value; }[[method-range:end]] }[[inherent-range:end]]\n[[override-range:start]][[override-name:start]]impl Readable for Widget[[override-name:end]] { [[override-read-range:start]]fn [[override-read-name:start]]read[[override-read-name:end]](self) -> i64 { return self.value; }[[override-read-range:end]] }[[override-range:end]]\n[[limit-range:start]]pub const [[limit-name:start]]LIMIT[[limit-name:end]]: i64 = 1;[[limit-range:end]]\n[[state-range:start]]pub state [[state-name:start]]live[[state-name:end]]: i64 = 1;[[state-range:end]]\n[[extern-range:start]]pub extern state [[extern-name:start]]external[[extern-name:end]]: i64;[[extern-range:end]]\n[[make-range:start]]pub fn [[make-name:start]]make[[make-name:end]](value: i64 = 1) -> Widget { return Widget { value, other: 1 }; }[[make-range:end]]\n[[private-range:start]]struct [[private-name:start]]Private[[private-name:end]] { [[private-value-range:start]][[private-value-name:start]]value[[private-value-name:end]]: bool[[private-value-range:end]] }[[private-range:end]]\n",
    "scripts/main.vela": "use source::Widget as Row; use source::Choice as Pick; use source::Choice::Empty as Unit;\nuse source::Readable as Reader; use source::make as build; use source::LIMIT as Cap;\nuse source::live as Shared; use source::external as External; use source as api;\nuse host::Box as Host; use host::Choice as HostPick; use host::Readable as HostReader;\nuse host::make as host_build; use host as native; use metadata::Box as Metadata;\nuse std::array as arrays; use std::print as output;\n/* 中😀 */ [[local-range:start]]struct [[local-name:start]]Widget[[local-name:end]] { [[local-value-range:start]][[local-value-name:start]]value[[local-value-name:end]]: bool[[local-value-range:end]] }[[local-range:end]]\n[[uses-range:start]]fn [[uses-name:start]]uses[[uses-name:end]](row: Row, host: Host, reader: Reader, hreader: HostReader, meta: Metadata, dynamic: Any) {\n let value = 1; let rec = Row { value, other: value }; let local = Widget { value: true };\n row.value += 1; row.read(); reader.read(); host.value += 1; host.read(); hreader.read();\n Pick::Empty; Pick::Pair(value); Pick::Named { value }; Unit;\n HostPick::Empty; HostPick::Pair(value); HostPick::Named { value }; meta.value; meta.read();\n build(value = 2); host_build(); native::make(); api::Widget { value, other: value }; Cap; Shared += 1; External += 1; arrays::new(); output(value);\n dynamic.value; dynamic.read(); row.missing; unknown::Box { value }; missing();\n match value { Pick::Named { value } => value, Pick::Pair(value) => value, Pick::Empty => 0 }\n}[[uses-range:end]]\n[[imported-impl-range:start]][[imported-impl-name:start]]impl Row[[imported-impl-name:end]] { [[added-range:start]]fn [[added-name:start]]added[[added-name:end]](self) -> bool { return true; }[[added-range:end]] }[[imported-impl-range:end]]\n[[host-impl-range:start]][[host-impl-name:start]]impl Host[[host-impl-name:end]] { [[scripted-range:start]]fn [[scripted-name:start]]scripted[[scripted-name:end]](self) -> i64 { return 1; }[[scripted-range:end]] }[[host-impl-range:end]]\n[[trait-imported-impl-range:start]][[trait-imported-impl-name:start]]impl Reader for Row[[trait-imported-impl-name:end]] { [[imported-read-range:start]]fn [[imported-read-name:start]]read[[imported-read-name:end]](self) -> i64 { return 1; }[[imported-read-range:end]] }[[trait-imported-impl-range:end]]\n",
    "scripts/imports.vela": "pub use source::Widget; use source::Choice; use source::Choice::Pair as Tuple; use source::Readable; use source::make; use source::LIMIT; use source::live; use source::external; use source as api;\nuse source::Private as Hidden; use missing::Widget as Missing; use host::Box as Row; use metadata::Box; use std::print; use std::array;\n",
    "scripts/unresolved.vela": "use missing::Widget as Row; use source::Private as Hidden; use source::NoType; use missing as api;\nuse source::Widget as Clash; use host::Box as Clash;\n[[unresolved-range:start]]fn [[unresolved-name:start]]unresolved[[unresolved-name:end]](dynamic: Any) { Row { value: 1 }; Hidden { value: true }; NoType::Missing; api::call(); Clash { value: 1 }; dynamic.value; dynamic.read(); unknown.value; unknown.read(); }[[unresolved-range:end]]\n",
    "scripts/deep/nested.vela": "[[nested-range:start]]pub struct [[nested-name:start]]Widget[[nested-name:end]] { [[nested-value-range:start]][[nested-value-name:start]]value[[nested-value-name:end]]: String[[nested-value-range:end]] }[[nested-range:end]]\n[[nested-fn-range:start]]pub fn [[nested-fn-name:start]]make[[nested-fn-name:end]]() -> Widget { return Widget { value: \"nested\" }; }[[nested-fn-range:end]]\n",
    "scripts/deep-user.vela": "use deep::nested as nested; use deep as directory; use deep::nested::Widget as Row;\n[[deep-use-range:start]]fn [[deep-use-name:start]]use_deep[[deep-use-name:end]]() { nested::make(); directory::nested::make(); deep::nested::Widget { value: \"中😀\" }; Row { value: \"text\" }; }[[deep-use-range:end]]\n",
    "scripts/origins.vela": "[[origin-box-range:start]]struct [[origin-box-name:start]]HostBox[[origin-box-name:end]] { [[origin-value-range:start]][[origin-value-name:start]]value[[origin-value-name:end]]: bool[[origin-value-range:end]] }[[origin-box-range:end]]\n[[origin-choice-range:start]]enum [[origin-choice-name:start]]HostChoice[[origin-choice-name:end]] { [[origin-empty-range:start]][[origin-empty-name:start]]Empty[[origin-empty-name:end]][[origin-empty-range:end]] }[[origin-choice-range:end]]\n[[origin-trait-range:start]]trait [[origin-trait-name:start]]HostReader[[origin-trait-name:end]] { [[origin-read-range:start]]fn [[origin-read-name:start]]read[[origin-read-name:end]](self) -> bool;[[origin-read-range:end]] }[[origin-trait-range:end]]\n[[origin-factory-range:start]]fn [[origin-factory-name:start]]factory[[origin-factory-name:end]]() -> bool { return true; }[[origin-factory-range:end]]\n",
    "scripts/collisions.vela": "[[collision-range:start]]pub struct [[collision-name:start]]Widget[[collision-name:end]] { [[collision-value-range:start]][[collision-value-name:start]]value[[collision-value-name:end]]: String[[collision-value-range:end]] }[[collision-range:end]]\n[[collision-fn-range:start]]pub fn [[collision-fn-name:start]]uses[[collision-fn-name:end]]() {}[[collision-fn-range:end]]\n",
