  "files": {
    "scripts/main.vela": "use [[import-root]]alpha::[[import-module]]api::[[import-function]]make as [[function-alias]]create;\nuse alpha::api::Cell as [[type-alias]]Imported;\nuse alpha::api::[[import-const]]BASE as [[const-alias]]DEFAULT;\nuse alpha::api::[[import-state]]shared as [[state-alias]]shared_alias;\nuse alpha::api::[[import-extern]]external as [[extern-alias]]external_alias;\nuse alpha::api::[[import-enum]]Choice as [[enum-import-alias]]Pick;\nuse alpha::api::[[import-trait]]Reader as [[trait-import-alias]]Read;\nuse alpha::api::[[private-import]]hidden as [[private-import-alias]]unavailable;\nuse missing::[[missing-import]]make as [[missing-import-alias]]missing_factory;\nfn run(value: Imported) {\n    let text = \"中😀\"; [[alias-call]]create();\n    alpha::api::[[qualified-call]]make();\n    [[imported-const]]DEFAULT;\n    [[imported-state]]shared_alias;\n    [[imported-extern]]external_alias;\n    alpha::api::[[qualified-const]]BASE;\n    alpha::api::[[qualified-state]]shared;\n    alpha::api::[[qualified-extern]]external;\n    [[constructor-alias]]Imported { value: 1 };\n    alpha::api::[[qualified-constructor]]Cell { value: 2 };\n    Pick::[[alias-variant]]Empty;\n    alpha::api::Choice::[[qualified-variant]]Empty;\n    create([[named-label]]value = value);\n    [[private-call]]unavailable();\n    alpha::api::[[qualified-private]]hidden();\n    [[missing-call]]missing_factory();\n    missing::[[unresolved-qualified]]make();\n    beta::api::[[other-module-call]]make();\n}\nfn shadowed([[shadow-param:start]]create[[shadow-param:end]]: Any) { [[shadow-call]]create(); }\nfn shadowed_type([[shadow-type-param:start]]Imported[[shadow-type-param:end]]: Any) { [[shadow-value]]Imported; }\nfn hinted(a: [[enum-alias]]Pick, b: [[trait-alias]]Read) {}\nuse alpha::api::[[missing-export]]absent as [[missing-export-alias]]Absent;\nuse alpha::api::[[direct-import]]make;\nfn direct() { [[direct-call]]make(); [[foreign-short]]foreign(); }\n",
    "scripts/alpha/api.vela": "/* 中😀 */ pub struct [[cell:start]]Cell[[cell:end]] { value: i64 }\npub fn [[make:start]]make[[make:end]]([[parameter:start]]value[[parameter:end]]: Cell = Cell { value: 1 }) -> Cell { return value; }\npub const [[base:start]]BASE[[base:end]]: Cell = Cell { value: 2 };\npub state [[shared:start]]shared[[shared:end]]: Cell = Cell { value: 3 };\npub extern state [[external:start]]external[[external:end]]: Cell;\npub enum [[choice:start]]Choice[[choice:end]] { [[empty:start]]Empty[[empty:end]] }\npub trait [[reader:start]]Reader[[reader:end]] { fn read(self) -> Cell; }\nfn hidden() -> Cell { return Cell { value: 4 }; }\n",
    "scripts/beta/api.vela": "/* 中😀 */ pub struct [[other:start]]Other[[other:end]] {}\npub fn [[make:start]]make[[make:end]]() -> Other { return Other {}; }\npub fn foreign() -> Other { return Other {}; }\n"
