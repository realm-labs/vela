    "vela.toml": "[package]\nid = \"dev.vela.callback_contracts\"\nname = \"callback_contracts\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n",
    "scripts/array.vela": "/* 中😀 */\nfn [[zero:start]]zz_zero[[zero:end]]() -> bool { return true; }\nfn [[one:start]]zz_one[[one:end]](value: i64) -> bool { return true; }\nfn [[two:start]]zz_two[[two:end]](key: String, value: i64) -> bool { return true; }\nfn [[defaulted:start]]zz_defaulted[[defaulted:end]](value: i64 = 1) -> bool { return true; }\nfn [[text:start]]zz_text[[text:end]](value: i64) -> String { return \"text\"; }\nfn [[erased:start]]zz_erased[[erased:end]](value: i64) -> Any { return (); }\nasync fn zz_async(value: i64) -> bool { return true; }\nfn run(items: Array<i64>, zz_dynamic: Any, zz_closure: Closure) { items.filter([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/map.vela": "/* 中😀 */\nfn [[zero:start]]zz_zero[[zero:end]]() -> bool { return true; }\nfn [[one:start]]zz_one[[one:end]](value: i64) -> bool { return true; }\nfn [[two:start]]zz_two[[two:end]](key: String, value: i64) -> bool { return true; }\nfn [[defaulted:start]]zz_defaulted[[defaulted:end]](value: i64 = 1) -> bool { return true; }\nfn [[text:start]]zz_text[[text:end]](value: i64) -> String { return \"text\"; }\nfn [[erased:start]]zz_erased[[erased:end]](value: i64) -> Any { return (); }\nasync fn zz_async(value: i64) -> bool { return true; }\nfn run(items: Map<String, i64>, zz_dynamic: Any, zz_closure: Closure) { items.filter(callback = [[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/fallback.vela": "/* 中😀 */\nfn [[zero:start]]zz_zero[[zero:end]]() -> bool { return true; }\nfn [[one:start]]zz_one[[one:end]](value: i64) -> bool { return true; }\nfn [[two:start]]zz_two[[two:end]](key: String, value: i64) -> bool { return true; }\nfn [[defaulted:start]]zz_defaulted[[defaulted:end]](value: i64 = 1) -> bool { return true; }\nfn [[text:start]]zz_text[[text:end]](value: i64) -> String { return \"text\"; }\nfn [[erased:start]]zz_erased[[erased:end]](value: i64) -> Any { return (); }\nasync fn zz_async(value: i64) -> bool { return true; }\nfn run(items: Option<i64>, zz_dynamic: Any, zz_closure: Closure) { items.or_else([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/fold.vela": "/* 中😀 */\nfn [[zero:start]]zz_zero[[zero:end]]() -> bool { return true; }\nfn [[one:start]]zz_one[[one:end]](value: i64) -> bool { return true; }\nfn [[two:start]]zz_two[[two:end]](key: String, value: i64) -> bool { return true; }\nfn [[defaulted:start]]zz_defaulted[[defaulted:end]](value: i64 = 1) -> bool { return true; }\nfn [[text:start]]zz_text[[text:end]](value: i64) -> String { return \"text\"; }\nfn [[erased:start]]zz_erased[[erased:end]](value: i64) -> Any { return (); }\nasync fn zz_async(value: i64) -> bool { return true; }\nfn run(items: Iterator<i64>, zz_dynamic: Any, zz_closure: Closure) { items.fold(0, [[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
