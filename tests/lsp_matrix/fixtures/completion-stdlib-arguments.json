  "files": {
    "vela.toml": "[package]\nid = \"dev.vela.stdlib_arguments\"\nname = \"stdlib_arguments\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n",
    "scripts/query_option_function.vela": "/* 中😀 */ fn main() { option::some([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_option_used.vela": "/* 中😀 */ fn main(value: Option<i64>) { option::unwrap_or(value, [[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_option_named.vela": "/* 中😀 */ fn main() { option::unwrap_or(fallback = 1, [[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_imported.vela": "/* 中😀 */ use option::some; fn main() { some([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_math.vela": "/* 中😀 */ fn main() { math::clamp([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_string.vela": "/* 中😀 */ fn main(text: String) { text.replace([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_bytes.vela": "/* 中😀 */ fn main(data: Bytes) { data.get([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_char.vela": "/* 中😀 */ fn main(ch: char) { ch.to_string([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_range.vela": "/* 中😀 */ fn main(r: Range) { r.len([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_array.vela": "/* 中😀 */ fn main(values: Array<i64>) { values.insert([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_array_default.vela": "/* 中😀 */ fn main(values: Array<i64>) { values.sum([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_array_view.vela": "/* 中😀 */ fn main(values: ArrayView<i64>) { values.get([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_array_mut.vela": "/* 中😀 */ fn main(values: ArrayMut<i64>) { values.insert([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_map.vela": "/* 中😀 */ fn main(values: Map<String, i64>) { values.insert([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_set.vela": "/* 中😀 */ fn main(values: Set<i64>) { values.insert([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_iterator.vela": "/* 中😀 */ fn main(values: Iterator<i64>) { values.take([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_option_method.vela": "/* 中😀 */ fn main(value: Option<i64>) { value.unwrap_or([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_result_method.vela": "/* 中😀 */ fn main(value: Result<i64, String>) { value.unwrap_or([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_reflection.vela": "/* 中😀 */ fn main() { reflect::has_type([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_reserved_name.vela": "/* 中😀 */ fn main() { reflect::implements([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_provider.vela": "/* 中😀 */ fn main() { math::random([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_unknown.vela": "/* 中😀 */ fn main() { missing::some([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_shadowed.vela": "/* 中😀 */ fn main(some: Function) { some([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_dynamic.vela": "/* 中😀 */ fn main(value: Any) { value.unwrap_or([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_array_mut_read.vela": "/* 中😀 */ fn main(values: ArrayMut<i64>) { values.get([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_import_alias.vela": "/* 中😀 */ use option::some as wrap; fn main() { wrap([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_module_alias.vela": "/* 中😀 */ use option as opt; fn main() { opt::some([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_group_import.vela": "/* 中😀 */ use option::{some, none}; fn main() { some([[replace:start]][[cursor]][[replace:end]]); }\n",
    "scripts/query_ambiguous_import.vela": "/* 中😀 */ use option::some as wrap; use result::ok as wrap; fn main() { wrap([[replace:start]][[cursor]][[replace:end]]); }\n",
    "schema.json": "{\n  \"formatVersion\": 1,\n  \"facts\": {\n    \"functions\": [\n      {\n        \"name\": \"host::growable\",\n        \"fact\": {\n          \"kind\": \"function\",\n          \"params\": [],\n          \"returns\": {\n            \"kind\": \"arrayMut\",\n            \"element\": {\n              \"kind\": \"primitive\",\n              \"name\": \"i64\"\n            },\n            \"mutation\": \"growable\"\n          }\n        }\n      }\n    ]\n  }\n}\n",
    "scripts/query_array_growable.vela": "/* 中😀 */ fn main() { host::growable().insert([[replace:start]][[cursor]][[replace:end]]); }\n"
