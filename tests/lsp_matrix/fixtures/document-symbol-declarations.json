    "scripts/api.vela": "use helper::external as imported; pub use helper::Widget as Row;\n[[limit-range:start]]pub const [[limit-name:start]]LIMIT[[limit-name:end]]: i64 = 3;[[limit-range:end]]\n[[label-range:start]]const [[label-name:start]]LABEL[[label-name:end]] = \"中😀\";[[label-range:end]]\n[[counter-range:start]]pub state [[counter-name:start]]counter[[counter-name:end]]: i64 = 0;[[counter-range:end]]\n[[state-range:start]]state [[state-name:start]]local_state[[state-name:end]]: String = \"text\";[[state-range:end]]\n[[external-range:start]]pub extern state [[external-name:start]]live[[external-name:end]]: Widget;[[external-range:end]]\n[[hidden-range:start]]extern state [[hidden-name:start]]hidden[[hidden-name:end]]: bool;[[hidden-range:end]]\n[[choose-range:start]]#[doc(\"中😀 choose before its identifier\")]\npub fn [[choose-name:start]]choose[[choose-name:end]](value: i64, amount: i64 = 2) -> i64 {\n let shadow = amount;\n return value + shadow;\n}[[choose-range:end]]\n[[private-range:start]]fn [[private-name:start]]private_fn[[private-name:end]](value) { return value; }[[private-range:end]]\n[[zero-range:start]]fn [[zero-name:start]]zero[[zero-name:end]]() {}[[zero-range:end]]\n[[async-range:start]]pub async fn [[async-name:start]]worker[[async-name:end]](value: i64) -> i64 { return value; }[[async-range:end]]\n[[widget-range:start]]pub struct [[widget-name:start]]Widget[[widget-name:end]] {\n [[value-range:start]][[value-name:start]]value[[value-name:end]]: i64 = 1[[value-range:end]]\n [[misc-range:start]][[misc-name:start]]misc[[misc-name:end]]: Any[[misc-range:end]]\n}[[widget-range:end]]\n[[private-struct-range:start]]struct [[private-struct-name:start]]Private[[private-struct-name:end]] { [[private-field-range:start]][[private-field-name:start]]flag[[private-field-name:end]]: bool[[private-field-range:end]] }[[private-struct-range:end]]\n[[choice-range:start]]pub enum [[choice-name:start]]Choice[[choice-name:end]] {\n [[unit-range:start]][[unit-name:start]]Empty[[unit-name:end]][[unit-range:end]]\n [[tuple-range:start]][[tuple-name:start]]Pair[[tuple-name:end]]([[count-range:start]][[count-name:start]]count[[count-name:end]]: i64 = 2[[count-range:end]], [[reason-range:start]][[reason-name:start]]reason[[reason-name:end]]: String[[reason-range:end]])[[tuple-range:end]]\n [[record-range:start]][[record-name:start]]Named[[record-name:end]] { [[key-range:start]][[key-name:start]]key[[key-name:end]]: String[[key-range:end]] }[[record-range:end]]\n}[[choice-range:end]]\n[[private-enum-range:start]]enum [[private-enum-name:start]]HiddenChoice[[private-enum-name:end]] {}[[private-enum-range:end]]\n[[readable-range:start]]pub trait [[readable-name:start]]Readable[[readable-name:end]] {\n [[required-range:start]]#[doc(\"中😀 read misleading name\")] fn [[required-name:start]]read[[required-name:end]](self, amount: i64 = 1) -> i64;[[required-range:end]]\n [[default-range:start]]fn [[default-name:start]]preview[[default-name:end]](self, amount: i64 = 2) -> bool { return amount > 0; }[[default-range:end]]\n}[[readable-range:end]]\n[[private-trait-range:start]]trait [[private-trait-name:start]]HiddenTrait[[private-trait-name:end]] {}[[private-trait-range:end]]\n[[impl-range:start]]#[doc(\"impl Widget before actual header\")]\n[[impl-name:start]]impl Widget[[impl-name:end]] {\n [[inherent-range:start]]#[doc(\"中😀 accept decoy\")] pub fn [[inherent-name:start]]accept[[inherent-name:end]](self, amount: i64 = 2) -> bool { return amount > 0; }[[inherent-range:end]]\n [[async-method-range:start]]pub async fn [[async-method-name:start]]process[[async-method-name:end]](self, value: i64) -> String { return \"done\"; }[[async-method-range:end]]\n}[[impl-range:end]]\n[[trait-impl-range:start]][[trait-impl-name:start]]impl Readable for Widget[[trait-impl-name:end]] {\n [[override-range:start]]fn [[override-name:start]]read[[override-name:end]](self, amount: i64) -> i64 { return amount; }[[override-range:end]]\n}[[trait-impl-range:end]]\n[[uses-range:start]]fn [[uses-name:start]]uses[[uses-name:end]]() {\n let value = 1;\n let alias = Row { value: true };\n let row = Widget { value, misc: 2 };\n row.value += 1; row.accept(1); imported();\n Choice::Empty; Choice::Pair(1, \"text\"); Choice::Named { key: \"text\" };\n}[[uses-range:end]]\n",
