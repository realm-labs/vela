pub struct Returned { [[payload:start]]payload[[payload:end]]: String }
impl Token { fn [[choose:start]]choose[[choose:end]](self, zz_dep_changed: String) -> String { zz_dep_changed } fn [[next:start]]next[[next:end]](self) -> Returned { Returned { payload: "updated" } } }
pub trait Reader { fn [[read:start]]read[[read:end]](self, zz_dep_changed: String) -> String { zz_dep_changed } fn [[fallback:start]]fallback[[fallback:end]](self) -> Returned { Returned { payload: "updated" } } }
impl Reader for Token {}
