fn inferred(value) { return value; }
fn erased(any: Any, unknown: Missing) { inferred([[unhinted]]any); any.check([[dynamic]]1); unknown.check([[unknown-receiver]]1); absent([[unresolved]]1); }
fn range_method(value: Range) { value.len([[range-method]]); }
