use game::reward::grant
use game::reward::Reward

pub struct Player {
    level: i64
}

pub fn main(player: Player) -> i64 {
    if player.level > 1 {
        return match player.level {
            1 => {
                return 1
            }
            _ => {
                return 2
            }
        }
    }
    return 0
}