trait Rewardable {
    #[doc("Preview reward")]
    fn preview(self, amount: i64) -> bool { return amount > 0 }
}
struct Player {
    level: i64,
}
struct Inventory {
    slots: i64,
}
impl Player {
    fn inventory(self) -> Inventory { return Inventory { slots: 1 } }
}
impl Rewardable for Inventory {}
pub fn main(player: Player) {
    return player.inventory().preview(1)
}