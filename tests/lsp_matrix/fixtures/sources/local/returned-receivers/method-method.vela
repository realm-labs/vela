struct Player {
    level: i64,
}
struct Inventory {
    slots: i64,
}
impl Player {
    fn inventory(self) -> Inventory { return Inventory { slots: 1 } }
}
impl Inventory {
    fn grant(self, amount: i64) -> bool {
        return amount > 0
    }
}
pub fn main(player: Player) {
    return player.inventory().grant(3)
}