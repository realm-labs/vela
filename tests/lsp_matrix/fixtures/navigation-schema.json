    "scripts/main.vela": "fn main(boxed: [[box-hint]]HostBox, cell: [[cell-hint]]HostCell, reader: [[trait-hint]]HostReader, metadata: [[metadata-hint]]MetadataOnly, unknown) {\n    let text = \"中😀\"; boxed.[[field-use]]item;\n    boxed.[[field-write]]item = cell;\n    boxed.[[primitive-field]]level;\n    boxed.[[method-use]]get();\n    reader.[[trait-method]]read();\n    [[function-use]]make_box().[[returned-field]]item;\n    boxed.get().[[nested-field]]value;\n    HostChoice::[[unit-variant]]Empty;\n    HostChoice::[[tuple-variant]]Number(1);\n    HostChoice::[[record-variant]]Record { cell: cell };\n    metadata.[[metadata-field]]value;\n    metadata.[[metadata-method]]get();\n    boxed.[[missing-field]]missing;\n    unknown.[[dynamic-field]]item;\n    unknown.[[dynamic-method]]get();\n    [[unknown-function]]missing_call();\n}\nfn variants(value) {\n    match value { HostChoice::[[pattern-variant]]Number(n) => n, _ => 0 };\n    HostChoice::[[missing-variant]]Missing;\n    MetadataChoice::[[metadata-variant]]Only;\n}\n",
    "scripts/origins.vela": "/* 中😀 */ fn [[box:start]]box_origin[[box:end]]() {}\n/* 中😀 */ fn [[cell:start]]cell_origin[[cell:end]]() {}\n/* 中😀 */ fn [[reader:start]]reader_origin[[reader:end]]() {}\n/* 中😀 */ fn [[item:start]]item_origin[[item:end]]() {}\n/* 中😀 */ fn [[level:start]]level_origin[[level:end]]() {}\n/* 中😀 */ fn [[get:start]]get_origin[[get:end]]() {}\n/* 中😀 */ fn [[read:start]]read_origin[[read:end]]() {}\n/* 中😀 */ fn [[make:start]]make_origin[[make:end]]() {}\n/* 中😀 */ fn [[value:start]]value_origin[[value:end]]() {}\n/* 中😀 */ fn [[choice:start]]choice_origin[[choice:end]]() {}\n/* 中😀 */ fn [[empty:start]]empty_origin[[empty:end]]() {}\n/* 中😀 */ fn [[number:start]]number_origin[[number:end]]() {}\n/* 中😀 */ fn [[record:start]]record_origin[[record:end]]() {}\n",
    "vela.toml": "[package]\nid = 'dev.vela.navigation'\nname = 'navigation'\nversion = '0.1.0'\n[source]\nroots = ['scripts']\n[host]\nschema = 'target/schema.json'\n",
    "scripts/local.vela": "enum [[source-choice:start]]HostChoice[[source-choice:end]] { [[source-empty:start]]Empty[[source-empty:end]] }\nstruct [[source-box:start]]HostBox[[source-box:end]] { [[source-item:start]]item[[source-item:end]]: i64 }\nfn collisions(boxed: [[source-hint]]HostBox) { boxed.[[source-field]]item; HostChoice::[[source-variant]]Empty; }\n"
