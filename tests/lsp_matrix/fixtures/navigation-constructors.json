    "scripts/main.vela": "use api::Box as Foreign;\nuse api::Choice as ForeignChoice;\nstruct [[cell:start]]Cell[[cell:end]] { [[value-field:start]]value[[value-field:end]]: i64 }\nstruct [[box:start]]Box[[box:end]] { [[item-field:start]]item[[item-field:end]]: Cell }\nenum [[choice:start]]Choice[[choice:end]] {\n    [[unit:start]]Empty[[unit:end]],\n    [[tuple:start]]Tuple[[tuple:end]]([[tuple-field:start]]item[[tuple-field:end]]: Cell),\n    [[record:start]]Record[[record:end]] { [[record-field:start]]item[[record-field:end]]: Cell },\n}\nfn run([[item-param:start]]item[[item-param:end]]: Cell, boxed: Box, unknown: Any) {\n    let text = \"\u4e2d\ud83d\ude00\"; [[constructor]]Box { [[field-label]]item: [[field-value]]item };\n    Box { [[shorthand]]item };\n    Box { [[missing-label]]missing: item };\n    Missing { [[missing-owner-label]]item: item };\n    Choice::[[tuple-constructor]]Tuple([[tuple-value]]item);\n    Choice::Tuple([[tuple-label]]item = item);\n    Choice::Tuple([[tuple-unknown-label]]missing = item);\n    Choice::[[record-constructor]]Record { [[variant-field-label]]item: item };\n    Choice::Record { [[variant-shorthand]]item };\n    Choice::Record { [[variant-unknown-label]]missing: item };\n    Choice::Missing { [[unknown-variant-label]]item: item };\n    Choice::[[unit-constructor]]Empty;\n    boxed.[[field-set]]item = item;\n    boxed.item.[[field-add]]value += 1;\n    boxed.item.[[field-subtract]]value -= 1;\n    unknown.[[dynamic-write]]item = item;\n    unknown.[[dynamic-add]]value += 1;\n    Foreign { [[foreign-label]]item: item };\n    ForeignChoice::Record { [[foreign-variant-label]]item: item };\n    ForeignChoice::Tuple([[foreign-tuple-label]]item = item);\n}\nfn patterns(value: Choice) {\n    match value { Choice::[[record-pattern]]Record { [[pattern-label]]item: [[binding:start]]bound[[binding:end]] } => [[binding-use]]bound, _ => Cell { value: 0 } };\n    match value { Choice::Tuple([[tuple-binding:start]]bound[[tuple-binding:end]