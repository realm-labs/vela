    "vela.toml": "[package]\nid = \"dev.vela.schema_methods\"\nname = \"schema_methods\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"target/schema.json\"\n",
    "scripts/helpers.vela": "/* 中😀 */ pub fn [[method-decl:start]]add[[method-decl:end]]([[host-param-decl:start]]amount[[host-param-decl:end]]: i64) {}\n",
    "scripts/consumer.vela": "/* 中😀 */ pub fn [[other-decl:start]]add[[other-decl:end]]([[other-param-decl:start]]amount[[other-param-decl:end]]: i64) {}\nfn closed(item: host::Counter) { item.[[closed-call:start]]add[[closed-call:end]]([[closed-label:start]]amount[[closed-label:end]] = 3); }\n",
    "scripts/trait_defs.vela": "/* 中😀 */ pub fn [[trait-decl:start]]add[[trait-decl:end]]([[trait-param-decl:start]]amount[[trait-param-decl:end]]: i64) {}\n",
    "scripts/main.vela": "use host::Counter as Count\nuse host::Measure as Measured\nstruct Counter {}\nimpl Counter { fn [[source-decl:start]]add[[source-decl:end]](self, [[source-param-decl:start]]value[[source-param-decl:end]]: i64) -> i64 { return [[source-param-use:start]]value[[source-param-use:end]]; } }\nfn returned(item: Count) -> Count { return item; }\n/* 中😀 */ fn main(item: Count, other: third::Counter, measured: Measured, source: Counter, meta: other::Counter, [[caller-decl:start]]amount[[caller-decl:end]]: i64) {\n item.[[main-call:start]]add[[main-call:end]]([[main-label:start]]amount[[main-label:end]] = [[caller-use:start]]amount[[caller-use:end]]);\n returned(item).[[returned-call:start]]add[[returned-call:end]]([[returned-label:start]]amount[[returned-label:end]] = 2);\n let call = || item.[[closure-call:start]]add[[closure-call:end]]([[closure-label:start]]amount[[closure-label:end]] = 3);\n other.[[other-call:start]]add[[other-call:end]]([[other-label:start]]amount[[other-label:end]] = 4);\n measured.[[trait-call:start]]add[[trait-call:end]]([[trait-label:start]]amount[[trait-label:end]] = 5);\n source.[[source-call:start]]add[[source-call:end]]([[source-label:start]]value[[source-label:end]] = 6);\n meta.[[metadata-call:start]]add[[metadata-call:end]]([[metadata-label:start]]amount[[metadata-label:end]] = 7);\n meta.[[metadata-again:start]]add[[metadata-again:end]](8);\n item.[[unknown-method:start]]bogus[[unknown-method:end]](9);\n item.[[unknown-label-call:start]]add[[unknown-label-call:end]]([[unknown-label:start]]bogus[[unknown-label:end]] = 10);\n let note = \"[[literal:start]]add[[literal:end]]\";\n}\nfn unknown(item) { item.[[unknown-receiver:start]]add[[unknown-receiver:end]](1); }\n"
  },
