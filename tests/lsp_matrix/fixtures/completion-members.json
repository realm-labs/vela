    "vela.toml": "[package]\nid = \"dev.vela.completion_types\"\nname = \"completion_types\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n",
    "scripts/alpha.vela": "pub struct Cell { value: i64 }\npub struct Player { level: i64 child: Cell }\npub trait Rewardable { fn grant(self, amount: i64) -> bool; fn preview(self) -> bool { return true; } }\nimpl Player { fn level_up(self, amount: i64) -> bool { return true; } }\nimpl Rewardable for Player { fn grant(self, amount: i64) -> bool { return true; } }\npub fn make() -> Player { return Player { level: 1, child: Cell { value: 1 } }; }\npub fn erase() -> Any { return null; }\n",
    "scripts/beta.vela": "pub struct Player { leak: String }\npub trait Rewardable { fn counterfeit(self) -> String; }\nimpl Player { fn counterfeit(self) -> String { return \"bad\"; } }\n",
    "scripts/query_source_all.vela": "/* 中😀 */ fn main(p: alpha::Player) { p.[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/query_source_field.vela": "/* 中😀 */ fn main(p: alpha::Player) { p.[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_source_method.vela": "/* 中😀 */ fn main(p: alpha::Player) { p.[[replace:start]]level_u[[cursor]][[replace:end]]; }\n",
    "scripts/query_source_write.vela": "/* 中😀 */ fn main(p: alpha::Player) { p.[[replace:start]]le[[cursor]][[replace:end]] = 2; }\n",
    "scripts/query_source_chain.vela": "/* 中😀 */ fn main(p: alpha::Player) { p.child.[[replace:start]]va[[cursor]][[replace:end]]; }\n",
    "scripts/query_source_return.vela": "/* 中😀 */ fn main() { alpha::make().[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_other_owner.vela": "/* 中😀 */ fn main(p: beta::Player) { p.[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/query_trait_owner.vela": "/* 中😀 */ fn main(p: alpha::Rewardable) { p.[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/query_other_trait.vela": "/* 中😀 */ fn main(p: beta::Rewardable) { p.[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/query_schema_all.vela": "/* 中😀 */ fn main(p: HostPlayer) { p.[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/query_schema_field.vela": "/* 中😀 */ fn main(p: HostPlayer) { p.[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_schema_method.vela": "/* 中😀 */ fn main(p: HostPlayer) { p.[[replace:start]]level_u[[cursor]][[replace:end]]; }\n",
    "scripts/query_schema_chain.vela": "/* 中😀 */ fn main(p: HostPlayer) { p.child.[[replace:start]]va[[cursor]][[replace:end]]; }\n",
    "scripts/query_schema_return.vela": "/* 中😀 */ fn main() { host_make().[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_any.vela": "/* 中😀 */ fn level_up() {} fn main(p: Any) { let level = 9; p.[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_unknown.vela": "/* 中😀 */ fn level_up() {} fn main(p) { let level = 9; p.[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_missing.vela": "/* 中😀 */ fn level_up() {} fn main(p: Missing) { let level = 9; p.[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_source_erased.vela": "/* 中😀 */ fn level_up() {} fn main() { let level = 9; alpha::erase().[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_schema_erased.vela": "/* 中😀 */ fn level_up() {} fn main() { let level = 9; host_erase().[[replace:start]]le[[cursor]][[replace:end]]; }\n",
    "scripts/query_source_record.vela": "/* 中😀 */ fn main() { let level = 1; let p = alpha::Player { child: alpha::Cell { value: 1 }, [[replace:start]]le[[cursor]][[replace:end]] }; }\n",
    "scripts/query_source_record_all.vela": "/* 中😀 */ fn main() { let p = alpha::Player { [[replace:start]][[cursor]][[replace:end]] }; }\n",
    "scripts/query_schema_record.vela": "/* 中😀 */ fn main() { let level = 1; let p = HostPlayer { child: null, [[replace:start]]le[[cursor]][[replace:end]] }; }\n",
