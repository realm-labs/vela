    "vela.toml": "[package]\nid = \"dev.vela.schema_functions\"\nname = \"schema_functions\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"target/schema.json\"\n",
    "scripts/helpers.vela": "/* 中😀 */ pub fn [[decl:start]]grant[[decl:end]]() {}\n",
    "scripts/consumer.vela": "use host::[[plain-import:start]]grant[[plain-import:end]]\nfn closed() { [[bare:start]]grant[[bare:end]](); let f = host::[[closed-value:start]]grant[[closed-value:end]]; }\n",
    "scripts/main.vela": "use host::[[alias-terminal:start]]grant[[alias-terminal:end]] as [[alias-decl:start]]deliver[[alias-decl:end]]\nuse host as bridge\nuse meta::ping as [[meta-alias-decl:start]]probe[[meta-alias-decl:end]]\nuse unknown::grant as missing\npub fn [[source-decl:start]]grant[[source-decl:end]]() {}\n/* 中😀 */ fn main() {\n host::[[call:start]]grant[[call:end]]();\n let f = host::[[value:start]]grant[[value:end]];\n let c = || host::[[closure:start]]grant[[closure:end]]();\n [[source-call:start]]grant[[source-call:end]]();\n meta::[[meta-call:start]]ping[[meta-call:end]]();\n let m = meta::[[meta-value:start]]ping[[meta-value:end]];\n let text = \"[[literal:start]]grant[[literal:end]]\";\n unknown::[[unknown:start]]grant[[unknown:end]]();\n}\nfn shadow([[local-decl:start]]grant[[local-decl:end]]) { [[local-call:start]]grant[[local-call:end]](); }\nfn aliases() {\n [[alias-call:start]]deliver[[alias-call:end]]();\n let f = [[alias-value:start]]deliver[[alias-value:end]];\n let c = || [[alias-closure:start]]deliver[[alias-closure:end]]();\n bridge::[[module-call:start]]grant[[module-call:end]]();\n [[meta-alias-call:start]]probe[[meta-alias-call:end]]();\n [[unknown-alias:start]]missing[[unknown-alias:end]]();\n}\nfn local_alias([[alias-local-decl:start]]deliver[[alias-local-decl:end]]) { [[alias-local-call:start]]deliver[[alias-local-call:end]](); }\n",
    "scripts/retained.vela": "use host::[[same-terminal:start]]grant[[same-terminal:end]] as [[same-alias:start]]grant[[same-alias:end]]\nfn retained() { [[same-call:start]]grant[[same-call:end]](); let f = [[same-value:start]]grant[[same-value:end]]; }\n"
