    "vela.toml": "[package]\nid = \"dev.vela.callable_hints\"\nname = \"callable_hints\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n",
    "scripts/api.vela": "pub struct Row { count: bool } struct Hidden {} pub const Mask: i64 = 1;\n",
    "scripts/function.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(rows: Array<Alias>) -> Array<Alias> { rows }\nfn main(rows: Array<Alias>, level: i64) { accept(rows)[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/provider.vela": "use host::Row as Alias;\n/* 中😀 */ trait Provider { fn echo(self, rows: Array<Alias>) -> Array<Alias>; } pub struct Worker {} #[provider(id = \"worker\")] impl Provider for Worker { pub fn echo(self, rows: Array<Alias>) -> Array<Alias> { rows } }\nfn main(rows: Array<Alias>, level: i64, worker: Worker) { worker.echo(rows)[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/default.vela": "use host::Row as Alias;\n/* 中😀 */ trait Provider { fn echo(self, rows: Array<Alias>) -> Array<Alias> { rows } } pub struct Worker {} #[provider(id = \"worker\")] impl Provider for Worker {}\nfn main(rows: Array<Alias>, level: i64, worker: Worker) { worker.echo(rows)[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/field.vela": "use host::Row as Alias;\n/* 中😀 */ struct Holder { rows: Array<Alias> }\nfn main(rows: Array<Alias>, level: i64, holder: Holder) { holder.rows[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/constant.vela": "use host::Row as Alias;\n/* 中😀 */ const ROWS: Array<Alias> = [];\nfn main(rows: Array<Alias>, level: i64) { ROWS[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/state.vela": "use host::Row as Alias;\n/* 中😀 */ extern state STATE: Array<Alias>;\nfn main(rows: Array<Alias>, level: i64) { STATE[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/source_function.vela": "use api::Row as Alias;\n/* 中😀 */ fn accept(rows: Array<Alias>) -> Array<Alias> { rows }\nfn main(rows: Array<Alias>, level: i64) { accept(rows)[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/source_provider.vela": "use api::Row as Alias;\n/* 中😀 */ trait Provider { fn echo(self, rows: Array<Alias>) -> Array<Alias>; } pub struct Worker {} #[provider(id = \"worker\")] impl Provider for Worker { pub fn echo(self, rows: Array<Alias>) -> Array<Alias> { rows } }\nfn main(rows: Array<Alias>, level: i64, worker: Worker) { worker.echo(rows)[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
    "scripts/missing.vela": "use missing::Row as Alias;\n/* 中😀 */ fn accept(rows: Array<Alias>) -> Array<Alias> { rows }\nfn main(rows: Array<Alias>, level: i64) { accept(rows)[0].[[replace:start]]co[[cursor]][[replace:end]]; }\n",
