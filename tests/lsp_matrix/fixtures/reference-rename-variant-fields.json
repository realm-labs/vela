    "vela.toml": "[package]\nid = \"dev.vela.variant_fields\"\nname = \"variant_fields\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "scripts/helpers.vela": "/* 中😀 */ pub enum Event { Item { [[field-decl:start]]value[[field-decl:end]]: i64, spare: i64 }, Other { [[sibling-decl:start]]value[[sibling-decl:end]]: i64 }, Unit, Tuple(item: i64) }\n",
    "scripts/consumer.vela": "/* 中😀 */ pub enum Event { Item { [[other-decl:start]]value[[other-decl:end]]: i64 } }\nfn closed() { helpers::Event::Item { [[closed-label:start]]value[[closed-label:end]]: 3, spare: 0 }; }\nfn other([[other-param:start]]value[[other-param:end]]: i64) { Event::Item { [[other-shorthand:start]]value[[other-shorthand:end]] }; }\n",
    "scripts/main.vela": "use helpers::Event as Alias\nuse helpers::Event::Item as ItemAlias\n/* 中😀 */ fn main([[main-param:start]]value[[main-param:end]]: i64) {\n let x = Alias::Item { [[alias-label:start]]value[[alias-label:end]]: value, spare: 0 };\n let y = ItemAlias { [[qualified-shorthand:start]]value[[qualified-shorthand:end]], spare: 1 };\n match x { Alias::Item { [[pattern-label:start]]value[[pattern-label:end]]: extracted, spare: _ } => extracted };\n match y { helpers::Event::Item { [[pattern-shorthand:start]]value[[pattern-shorthand:end]], spare: _ } => [[pattern-body:start]]value[[pattern-body:end]] };\n consumer::Event::Item { [[other-label:start]]value[[other-label:end]]: 9 };\n helpers::Event::Other { [[sibling-label:start]]value[[sibling-label:end]]: 2 };\n match x { Alias::Other { [[sibling-pattern:start]]value[[sibling-pattern:end]]: extracted } => extracted };\n let note = \"[[literal:start]]value[[literal:end]]\";\n}\nfn invalid() { helpers::Event::Item { [[unknown-label:start]]bogus[[unknown-label:end]]: 4 }; Missing::Item { [[unknown-owner:start]]value[[unknown-owner:end]]: 7 }; }\nfn invalid_Unit() { helpers::Event::Unit { [[invalid-unit:start]]value[[invalid-unit:end]]: 4 }; }\nfn invalid_Tuple() { helpers::Event::Tuple { [[invalid-tuple:start]]value[[invalid-tuple:end]]: 4 }; }\nfn invalid_Missing() { helpers::Event::Missing { [[invalid-missing:start]]value[[invalid-missing:end]]: 4 }; }\n"
  },
