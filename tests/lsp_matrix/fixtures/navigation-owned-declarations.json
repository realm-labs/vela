    "scripts/main.vela": "use [[kw-use]]api::Thing as Imported;\nuse api::Behavior as ForeignBehavior;\n/* \u4e2d\ud83d\ude00 */ [[kw-pub]]pub [[kw-struct]]struct [[cell:start]]Cell[[cell:end]] { [[primitive-field:start]]value[[primitive-field:end]]: i64 }\npub struct [[box:start]]Box[[box:end]] { [[field:start]]item[[field:end]]: Cell }\npub [[kw-enum]]enum [[choice:start]]Choice[[choice:end]] { [[unit:start]]Empty[[unit:end]], [[tuple:start]]Tuple[[tuple:end]]([[tuple-field:start]]item[[tuple-field:end]]: Cell), [[record:start]]Record[[record:end]] { [[record-field:start]]item[[record-field:end]]: Cell } }\npub [[kw-const]]const [[constant:start]]BASE[[constant:end]]: Cell = Cell { value: 1 };\npub [[kw-state]]state [[state:start]]shared[[state:end]]: Cell = Cell { value: 2 };\npub [[kw-extern]]extern state [[external:start]]external[[external:end]]: Cell;\npub [[kw-fn]]fn [[function:start]]make[[function:end]]([[parameter:start]]item[[parameter:end]]: Cell, [[default-parameter:start]]fallback[[default-parameter:end]]: Cell = Cell { value: 3 }) -> Cell { let [[local:start]]value[[local:end]]: Cell = item; return value; }\nasync fn [[async-function:start]]fetch[[async-function:end]]([[async-parameter:start]]item[[async-parameter:end]]: Cell) -> Cell { return item; }\npub [[kw-trait]]trait [[reader:start]]Reader[[reader:end]] {\n    fn [[interface:start]]read[[interface:end]](self, [[interface-parameter:start]]item[[interface-parameter:end]]: Cell) -> Cell;\n    fn [[default-method:start]]fallback[[default-method:end]]([[trait-self:start]]self[[trait-self:end]], [[trait-parameter:start]]item[[trait-parameter:end]]: Cell = Cell { value: 4 }) -> Cell { return [[trait-use]]item; }\n}\n[[kw-impl]]impl [[inherent-owner]]Box {\n    fn [[method:start]]get[[method:end]]([[method-self:start]]self[[method-self:end]], [[method-parameter:start]]item[[method-parameter:end]]: Cell) -> Cell { let [[method-local:start]]value[[method-local:end]] = item; return [[method-local-use]]value; }\n}\nimpl [[trait-owner]]Reader for [[trait-target]]Box {\n    fn [[override:start]]read[[override:end]](self, [[override-parameter:start]]item[[override-parameter:end]]: Cell) -> Cell { return [[override-use]]item; }\n    fn extra(self, [[shadow-trait:start]]Reader[[shadow-trait:end]]: Any) { [[shadow-trait-use]]Reader; }\n}\nfn untyped([[unknown-param:start]]item[[unknown-param:end]]) { let [[unknown-local:start]]value[[unknown-local:end]] = item; }\nfn dynamic([[any-param:start]]item[[any-param:end]]: Any) { let [[any-local:start]]value[[any-local:end]]: Any = item; }\n// [[comment]]Reader is mentioned here.\nfn trivia() { let text = \"[[string]]Reader\"; [[keyword]]return; }\nimpl [[missing-trait]]Absent for [[missing-owner]]Missing {}\nimpl [[foreign-trait]]ForeignBehavior for [[foreign-target]]Imported {}\nimpl [[qualified-trait-prefix]]api::[[qualified-trait]]Behavior for api::[[qualified-target]]Thing {}\nimpl api::[[private-trait]]Secret for Imported {}\nimpl api::[[private-target]]Hidden {}\nfn modules() { [[builtin-module]]math::abs(1); api::[[missing-member]]absent(); }\n",
    "scripts/api.vela": "/* \u4e2d\ud83d\ude00 */ pub struct [[thing:start]]Thing[[thing:end]] {}\npub trait [[behavior:start]]Behavior[[behavior:end]] {}\ntrait Secret {}\nstruct Hidden {}\n"
