  "files": {
    "vela.toml": "[package]\nid = \"dev.vela.callable_hints\"\nname = \"callable_hints\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n",
    "scripts/api.vela": "pub struct Row { count: bool } struct Hidden {} pub const Mask: i64 = 1;\n",
    "schema.json": "{\n  \"formatVersion\": 1,\n  \"facts\": {\n    \"types\": [\n      {\n        \"name\": \"host::Row\",\n        \"fact\": {\n          \"kind\": \"host\",\n          \"name\": \"host::Row\"\n        }\n      },\n      {\n        \"name\": \"host::Issue\",\n        \"fact\": {\n          \"kind\": \"host\",\n          \"name\": \"host::Issue\"\n        }\n      },\n      {\n        \"name\": \"api::Row\",\n        \"fact\": {\n          \"kind\": \"host\",\n          \"name\": \"api::Row\"\n        }\n      },\n      {\n        \"name\": \"api::Hidden\",\n        \"fact\": {\n          \"kind\": \"host\",\n          \"name\": \"api::Hidden\"\n        }\n      },\n      {\n        \"name\": \"api::Mask\",\n        \"fact\": {\n          \"kind\": \"host\",\n          \"name\": \"api::Mask\"\n        }\n      },\n      {\n        \"name\": \"Alias\",\n        \"fact\": {\n          \"kind\": \"host\",\n          \"name\": \"Alias\"\n        }\n      },\n      {\n        \"name\": \"Row\",\n        \"fact\": {\n          \"kind\": \"host\",\n          \"name\": \"Row\"\n        }\n      }\n    ],\n    \"fields\": [\n      {\n        \"owner\": \"host::Row\",\n        \"name\": \"count\",\n        \"fact\": {\n          \"kind\": \"primitive\",\n          \"name\": \"i64\"\n        }\n      }\n    ],\n    \"functions\": [\n      {\n        \"name\": \"native::send\",\n        \"fact\": {\n          \"kind\": \"function\",\n          \"params\": [\n            {\n              \"kind\": \"primitive\",\n              \"name\": \"i64\"\n            }\n          ],\n          \"returns\": {\n            \"kind\": \"primitive\",\n            \"name\": \"bool\"\n          }\n        },\n        \"signature\": {\n          \"asyncness\": \"sync\",\n          \"parameters\": [\n            {\n              \"name\": \"zz_items\",\n              \"typeFact\": {\n                \"kind\": \"primitive\",\n                \"name\": \"i64\"\n              },\n              \"requirement\": \"required\"\n            }\n          ],\n          \"returns\": {\n            \"kind\": \"primitive\",\n            \"name\": \"bool\"\n          }\n        },\n        \"docs\": \"Registered prefix 中😀.\"\n      },\n      {\n        \"name\": \"native::legacy\",\n        \"fact\": {\n          \"kind\": \"function\",\n          \"params\": [\n            {\n              \"kind\": \"primitive\",\n              \"name\": \"i64\"\n            }\n          ],\n          \"returns\": {\n            \"kind\": \"primitive\",\n            \"name\": \"bool\"\n          }\n        }\n      }\n    ]\n  }\n}\n",
    "scripts/array.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Array<Alias>) -> bool { true }\nfn main(value: Array<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/array_view.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: ArrayView<Alias>) -> bool { true }\nfn main(value: ArrayView<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/array_mut.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: ArrayMut<Alias>) -> bool { true }\nfn main(value: ArrayMut<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/map.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Map<String, Alias>) -> bool { true }\nfn main(value: Map<String, Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/map_view.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: MapView<String, Alias>) -> bool { true }\nfn main(value: MapView<String, Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/map_mut.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: MapMut<String, Alias>) -> bool { true }\nfn main(value: MapMut<String, Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/set.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Set<Alias>) -> bool { true }\nfn main(value: Set<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/set_view.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: SetView<Alias>) -> bool { true }\nfn main(value: SetView<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/set_mut.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: SetMut<Alias>) -> bool { true }\nfn main(value: SetMut<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/iterator.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Iterator<Alias>) -> bool { true }\nfn main(value: Iterator<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/option.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Option<Alias>) -> bool { true }\nfn main(value: Option<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/result.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Result<Array<Alias>, host::Issue>) -> bool { true }\nfn main(value: Result<Array<Alias>, host::Issue>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/tuple.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: (Alias, Array<Alias>)) -> bool { true }\nfn main(value: (Alias, Array<Alias>)) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/direct.vela": "\n/* 中😀 */ fn accept(zz_items: host::Row) -> bool { true }\nfn main(value: host::Row) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/alias.vela": "use host::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Alias) -> bool { true }\nfn main(value: Alias) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/namespace.vela": "use host as Alias;\n/* 中😀 */ fn accept(zz_items: Array<Alias::Row>) -> bool { true }\nfn main(value: Array<Alias::Row>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/source.vela": "use api::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Array<Alias>) -> bool { true }\nfn main(value: Array<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/private.vela": "use api::Hidden as Alias;\n/* 中😀 */ fn accept(zz_items: Array<Alias>) -> bool { true }\nfn main(value: Array<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/non_type.vela": "use api::Mask as Alias;\n/* 中😀 */ fn accept(zz_items: Array<Alias>) -> bool { true }\nfn main(value: Array<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/missing.vela": "use missing::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Array<Alias>) -> bool { true }\nfn main(value: Array<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/duplicate.vela": "use host::Row as Alias; use api::Row as Alias;\n/* 中😀 */ fn accept(zz_items: Array<Alias>) -> bool { true }\nfn main(value: Array<Alias>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/qualified_miss.vela": "\n/* 中😀 */ fn accept(zz_items: Array<missing::Row>) -> bool { true }\nfn main(value: Array<missing::Row>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/generic_miss.vela": "\n/* 中😀 */ fn accept(zz_items: Missing<host::Row>) -> bool { true }\nfn main(value: Missing<host::Row>) { accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/provider_alias.vela": "use host::Row as Alias;\n/* 中😀 */ trait Provider { fn accept(self, zz_items: Array<Alias>) -> bool; } pub struct Worker {} #[provider(id = \"worker\")] impl Provider for Worker { pub fn accept(self, zz_items: Array<Alias>) -> bool { true } }\nfn main(value: Array<Alias>, runner: Worker) { runner.accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/provider_default.vela": "use host::Row as Alias;\n/* 中😀 */ trait Provider { fn accept(self, zz_items: Array<Alias>) -> bool { true } } pub struct Worker {} #[provider(id = \"worker\")] impl Provider for Worker {}\nfn main(value: Array<Alias>, runner: Worker) { runner.accept([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/native_prefix.vela": "/* 中😀 */ fn main(value: i64) { native::send([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/native_extra.vela": "/* 中😀 */ fn main(value: i64) { native::send(1, \"extra\", [[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/native_named_occupied.vela": "/* 中😀 */ fn main(value: i64) { native::send(zz_items = 1, [[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/native_legacy.vela": "/* 中😀 */ fn main(value: i64) { native::legacy([[replace:start]]arg[[cursor]][[replace:end]]); }\n"
