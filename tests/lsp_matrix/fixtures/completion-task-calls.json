    "scripts/task.vela": "/// Ordinary source function, not a task operation.\npub fn spawn_scoped(zz_source: bool) -> bool { return true; }\npub fn join(zz_source: bool) -> bool { return true; }\n",
    "scripts/other.vela": "pub fn spawn_scoped(zz_other: String) -> String { return \"\"; }\n",
    "scripts/direct.vela": "/* 中😀 */  fn main(zz_local: i64) { task::spawn_scoped([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/then_first.vela": "/* 中😀 */  fn main(zz_local: i64) { task::spawn_scoped_then([[replace:start]]zz_[[cursor]][[replace:end]], done); }\n",
    "scripts/then_second.vela": "/* 中😀 */ async fn worker() {} fn main(zz_local: i64) { task::spawn_scoped_then(worker(), [[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/literal_import_collision.vela": "/* 中😀 */ use other as task; fn main(zz_local: i64) { task::spawn_scoped([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/literal_local_collision.vela": "/* 中😀 */ const task: i64 = 1; fn main(zz_local: i64) { task::spawn_scoped([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/unknown.vela": "/* 中😀 */  fn main(zz_local: i64) { task::join([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/schema_unknown.vela": "/* 中😀 */  fn main(zz_local: i64) { task::ghost([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/namespace_alias.vela": "/* 中😀 */ use task as jobs; fn main(zz_local: i64) { jobs::spawn_scoped_then([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/function_alias.vela": "/* 中😀 */ use task::spawn_scoped_then as schedule; fn main(zz_local: i64) { schedule([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/source_alias.vela": "/* 中😀 */ use task::spawn_scoped as ordinary; fn main(zz_local: i64) { ordinary([[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/nested_worker.vela": "/* 中😀 */ async fn worker(zz_amount: i64) -> () {} fn main(zz_local: i64) { task::spawn_scoped(worker([[replace:start]]zz_[[cursor]][[replace:end]])); }\n",
    "scripts/extra_operand.vela": "/* 中😀 */ async fn worker() {} fn main(zz_local: i64) { task::spawn_scoped(worker(), [[replace:start]]zz_[[cursor]][[replace:end]]); }\n",
    "scripts/named_prefix.vela": "/* 中😀 */ fn main(zz_local: i64) { task::spawn_scoped([[replace:start]]inv[[cursor]][[replace:end]]); }\n",
    "scripts/named_label.vela": "/* 中😀 */ fn main(zz_local: i64) { task::spawn_scoped([[replace:start]]inv[[cursor]]ocation[[replace:end]] = zz_local); }\n"
