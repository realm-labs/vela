    "scripts/main.vela": "use helpers::Measure as Alias\n/* 中😀 */ fn main(item: Alias, other: consumer::Measure, concrete: consumer::Counter, [[caller-decl:start]]amount[[caller-decl:end]]: i64) {\n item.measure([[main-label:start]]amount[[main-label:end]] = [[caller-use:start]]amount[[caller-use:end]]);\n item.plain([[plain-label:start]]amount[[plain-label:end]] = 2);\n other.measure([[other-label:start]]amount[[other-label:end]] = 4);\n concrete.measure([[impl-label:start]]amount[[impl-label:end]] = 5, spare = 0, extra = 0);\n let call = || item.measure([[closure-label:start]]amount[[closure-label:end]] = 6);\n item.measure([[unknown-label:start]]bogus[[unknown-label:end]] = 7);\n let note = \"[[literal:start]]amount[[literal:end]]\";\n}\nfn incomplete(item: Alias) { item.measure([[recovery-label:start]]amount[[recovery-label:end]] = ); }\nfn unknown(item) { item.measure([[unknown-receiver:start]]amount[[unknown-receiver:end]] = 1); }\n"
