    "scripts/helpers.vela": "/* 中😀 */ pub trait Measure { fn measure(self, [[required-decl:start]]amount[[required-decl:end]]: i64, spare: i64 = { let captured = 1; [[first-default:start]]amount[[first-default:end]] + captured }, extra: i64 = [[second-default:start]]amount[[second-default:end]]) -> i64; fn plain(self, [[plain-decl:start]]amount[[plain-decl:end]]: i64) -> i64; }\n",
