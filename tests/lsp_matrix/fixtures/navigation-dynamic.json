    "scripts/main.vela": "use helper::source_any as imported_any;\nstruct [[cell:start]]Cell[[cell:end]] { value: i64 }\nstruct Holder { [[item:start]]item[[item:end]]: Cell }\nimpl Holder {\n    fn [[get:start]]get[[get:end]](self) -> Cell { return self.item; }\n    fn [[method:start]]opaque[[method:end]](self) -> Any { return self.item; }\n}\nfn [[source:start]]source_any[[source:end]]() -> Any { return Holder { item: Cell { value: 1 } }; }\nfn main(boxed: HostBox, holder: Holder) {\n    let text = \"中😀\"; [[source-call]]source_any().[[source-field]]item;\n    source_any().[[source-method]]get();\n    let value = source_any(); value.[[source-local-field]]item;\n    [[import-call]]imported_any().[[import-field]]item;\n    holder.[[source-method-call]]opaque().[[method-field]]item;\n    holder.opaque().[[method-method]]get();\n    [[schema-call]]schema_any().[[schema-field]]item;\n    schema_any().[[schema-method]]get();\n    let host = schema_any(); host.[[schema-local-field]]item;\n    boxed.[[schema-method-call]]opaque().[[host-method-field]]item;\n    boxed.opaque().[[host-method-method]]get();\n    holder.[[source-positive]]item;\n    boxed.[[schema-positive]]item;\n}\nfn shadowed(source_any: Any) { source_any().[[shadow-field]]item; }\n",
    "scripts/helper.vela": "struct Holder { item: i64 }\npub fn [[imported:start]]source_any[[imported:end]]() -> Any { return Holder { item: 1 }; }\n",
    "scripts/origins.vela": "/* 中😀 */ fn [[box:start]]box_origin[[box:end]]() {}\n/* 中😀 */ fn [[cell:start]]cell_origin[[cell:end]]() {}\n/* 中😀 */ fn [[reader:start]]reader_origin[[reader:end]]() {}\n/* 中😀 */ fn [[item:start]]item_origin[[item:end]]() {}\n/* 中😀 */ fn [[level:start]]level_origin[[level:end]]() {}\n/* 中😀 */ fn [[get:start]]get_origin[[get:end]]() {}\n/* 中😀 */ fn [[read:start]]read_origin[[read:end]]() {}\n/* 中😀 */ fn [[make:start]]make_origin[[make:end]]() {}\n/* 中😀 */ fn [[value:start]]value_origin[[value:end]]() {}\n/* 中😀 */ fn [[choice:start]]choice_origin[[choice:end]]() {}\n/* 中😀 */ fn [[empty:start]]empty_origin[[empty:end]]() {}\n/* 中😀 */ fn [[number:start]]number_origin[[number:end]]() {}\n/* 中😀 */ fn [[record:start]]record_origin[[record:end]]() {}\n"
