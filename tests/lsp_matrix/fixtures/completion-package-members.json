  "files": {
    "vela.toml": "[package]\nid = \"dev.vela.type_aliases\"\nname = \"type_aliases\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n[dependencies]\nexternal = { path = \"deps/external\" }\n",
    "deps/external/vela.toml": "[package]\nid = \"dev.vela.external\"\nname = \"external\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[dependencies]\nhidden = { path = \"../hidden\" }\n",
    "deps/hidden/vela.toml": "[package]\nid = \"dev.vela.hidden\"\nname = \"hidden\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "schema.json": "{\"formatVersion\":1,\"facts\":{\"types\":[{\"name\":\"api::Token\",\"fact\":{\"kind\":\"record\",\"name\":\"api::Token\"}}],\"methods\":[{\"owner\":\"api::Token\",\"name\":\"choose_schema\",\"fact\":{\"kind\":\"function\",\"params\":[],\"returns\":{\"kind\":\"primitive\",\"name\":\"String\"}},\"docs\":\"Wrong schema owner 中😀.\"}]}}",
    "scripts/api.vela": "/* 中😀 */\npub struct Token { [[tag:start]]tag[[tag:end]]: i64 }\npub struct Returned { [[payload:start]]payload[[payload:end]]: i64 }\nimpl Token { fn [[choose:start]]choose[[choose:end]](self, zz_root: i64) -> i64 { zz_root } fn [[next:start]]next[[next:end]](self) -> Returned { Returned { payload: 1 } } }\npub trait Reader { fn [[read:start]]read[[read:end]](self, zz_root: i64) -> i64 { zz_root } fn [[fallback:start]]fallback[[fallback:end]](self) -> Returned { Returned { payload: 1 } } }\nimpl Reader for Token {}\npub fn make() -> Token { Token { tag: 1 } }\n",
    "deps/external/scripts/api.vela": "/* 中😀 */\npub struct Token { [[tag:start]]tag[[tag:end]]: bool }\npub struct Returned { [[payload:start]]payload[[payload:end]]: bool }\nimpl Token { fn [[choose:start]]choose[[choose:end]](self, zz_dep: bool) -> bool { zz_dep } fn [[next:start]]next[[next:end]](self) -> Returned { Returned { payload: true } } }\npub trait Reader { fn [[read:start]]read[[read:end]](self, zz_dep: bool) -> bool { zz_dep } fn [[fallback:start]]fallback[[fallback:end]](self) -> Returned { Returned { payload: true } } }\nimpl Reader for Token {}\npub fn make() -> Token { Token { tag: true } }\n",
    "deps/hidden/scripts/api.vela": "/* 中😀 */\npub struct Token { [[tag:start]]tag[[tag:end]]: String }\npub struct Returned { [[payload:start]]payload[[payload:end]]: String }\nimpl Token { fn [[choose:start]]choose[[choose:end]](self, zz_hidden: String) -> String { zz_hidden } fn [[next:start]]next[[next:end]](self) -> Returned { Returned { payload: \"hidden\" } } }\npub trait Reader { fn [[read:start]]read[[read:end]](self, zz_hidden: String) -> String { zz_hidden } fn [[fallback:start]]fallback[[fallback:end]](self) -> Returned { Returned { payload: \"hidden\" } } }\nimpl Reader for Token {}\npub fn make() -> Token { Token { tag: \"hidden\" } }\n",
    "scripts/root_all.vela": "/* 中😀 */ fn run(value: api::Token) { value.[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/root_method.vela": "/* 中😀 */ fn run(value: api::Token) { value.[[replace:start]]cho[[cursor]][[replace:end]]; }\n",
    "scripts/root_default.vela": "/* 中😀 */ fn run(value: api::Token) { value.[[replace:start]]rea[[cursor]][[replace:end]]; }\n",
    "scripts/root_trait.vela": "/* 中😀 */ fn run(value: api::Reader) { value.[[replace:start]]rea[[cursor]][[replace:end]]; }\n",
    "scripts/root_alias.vela": "/* 中😀 */ use api::Token as Alias;\nfn run(value: Alias) { value.[[replace:start]]cho[[cursor]][[replace:end]]; }\n",
    "scripts/root_function_return.vela": "/* 中😀 */ fn run() { api::make().[[replace:start]]ta[[cursor]][[replace:end]]; }\n",
    "scripts/root_function_alias_return.vela": "/* 中😀 */ use api::make as make_alias; fn run() { make_alias().[[replace:start]]ta[[cursor]][[replace:end]]; }\n",
    "scripts/root_local_method_return.vela": "/* 中😀 */ fn run(value: api::Token) { let returned = value.next(); returned.[[replace:start]]pay[[cursor]][[replace:end]]; }\n",
    "scripts/root_method_return.vela": "/* 中😀 */ fn run(value: api::Token) { value.next().[[replace:start]]pay[[cursor]][[replace:end]]; }\n",
    "scripts/root_default_return.vela": "/* 中😀 */ fn run(value: api::Token) { value.fallback().[[replace:start]]pay[[cursor]][[replace:end]]; }\n",
    "scripts/root_schema_absent.vela": "/* 中😀 */ fn run(value: api::Token) { value.[[replace:start]]choose_s[[cursor]][[replace:end]]; }\n",
    "scripts/root_unknown.vela": "/* 中😀 */ fn run(value: api::Token) { value.[[replace:start]]missing[[cursor]][[replace:end]]; }\n",
    "scripts/dependency_all.vela": "/* 中😀 */ fn run(value: external::api::Token) { value.[[replace:start]][[cursor]][[replace:end]]; }\n",
