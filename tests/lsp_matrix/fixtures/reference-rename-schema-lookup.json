    "vela.toml": "[package]\nid = \"dev.vela.schema_functions\"\nname = \"schema_functions\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"target/schema.json\"\n",
