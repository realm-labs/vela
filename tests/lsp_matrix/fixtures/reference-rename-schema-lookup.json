    "scripts/main.vela": "pub fn [[source-decl:start]]grant[[source-decl:end]]() {}\n/* 中😀 */ fn main() {\n host::[[call:start]]grant[[call:end]]();\n let f = host::[[value:start]]grant[[value:end]];\n let c = || host::[[closure:start]]grant[[closure:end]]();\n [[source-call:start]]grant[[source-call:end]]();\n meta::[[meta-call:start]]ping[[meta-call:end]]();\n let m = meta::[[meta-value:start]]ping[[meta-value:end]];\n let text = \"[[literal:start]]grant[[literal:end]]\";\n unknown::[[unknown:start]]grant[[unknown:end]]();\n}\nfn shadow([[local-decl:start]]grant[[local-decl:end]]) { [[local-call:start]]grant[[local-call:end]](); }\n",
    "scripts/unused_import.vela": "use host::[[missing-import:start]]import_missing[[missing-import:end]] as retained\n"
