  "id": "reference-rename-imported-values",
  "files": {
    "vela.toml": "[package]\nid = \"dev.vela.imported_values\"\nname = \"imported_values\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "scripts/helpers.vela": "/* 中😀 */ [[pub-keyword:start]]pub[[pub-keyword:end]] [[const-keyword:start]]const[[const-keyword:end]] [[const-decl:start]]BASE_REWARD[[const-decl:end]]: i64 = 4;\npub [[extern-keyword:start]]extern[[extern-keyword:end]] [[state-keyword:start]]state[[state-keyword:end]] [[state-decl:start]]reward_scale[[state-decl:end]]: i64;\nconst [[private-decl:start]]SECRET[[private-decl:end]]: i64 = 7;\n[[private-state-keyword:start]]state[[private-state-keyword:end]] [[private-state-decl:start]]internal_total[[private-state-decl:end]]: i64 = 1;\nfn bump() { [[private-state-write:start]]internal_total[[private-state-write:end]] += 1; [[private-state-read:start]]internal_total[[private-state-read:end]]; }\nfn own() { let value = [[private-own:start]]SECRET[[private-own:end]]; }\n",
    "scripts/main.vela": "/* 中😀 */ use helpers::[[const-import:start]]BASE_REWARD[[const-import:end]];\nuse helpers::[[state-import:start]]reward_scale[[state-import:end]];\nfn main() { let value = [[const-use:start]]BASE_REWARD[[const-use:end]]; [[state-write:start]]reward_scale[[state-write:end]] += value; let other = helpers::[[const-qualified:start]]BASE_REWARD[[const-qualified:end]]; helpers::[[state-qualified:start]]reward_scale[[state-qualified:end]]; }\n",
    "scripts/consumer.vela": "/* 中😀 */ fn side() { let value = helpers::[[const-consumer:start]]BASE_REWARD[[const-consumer:end]]; helpers::[[state-consumer:start]]reward_scale[[state-consumer:end]]; }\n",
    "scripts/alias.vela": "/* 中😀 */ use helpers::[[const-alias-terminal:start]]BASE_REWARD[[const-alias-terminal:end]] as [[const-alias-decl:start]]BASE[[const-alias-decl:end]];\nuse helpers::[[state-alias-terminal:start]]reward_scale[[state-alias-terminal:end]] as [[state-alias-decl:start]]scale[[state-alias-decl:end]];\nfn aliases() { let value = [[const-alias-use:start]]BASE[[const-alias-use:end]]; [[state-alias-use:start]]scale[[state-alias-use:end]] += value; }\n",
    "scripts/module.vela": "/* 中😀 */ use helpers as h;\nfn module_values() { let value = h::[[const-module:start]]BASE_REWARD[[const-module:end]]; h::[[state-module:start]]reward_scale[[state-module:end]] += value; }\n",
    "scripts/private.vela": "/* 中😀 */ use helpers::[[private-import:start]]SECRET[[private-import:end]] as secret;\nfn invalid() { [[private-use:start]]secret[[private-use:end]]; }\n",
    "scripts/missing.vela": "/* 中😀 */ use absent::[[missing-import:start]]BASE_REWARD[[missing-import:end]] as absent_value;\nfn missing() { [[missing-use:start]]absent_value[[missing-use:end]]; }\n"
  },
