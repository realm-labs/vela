    "deps/hidden/scripts/api.vela": "/* 中😀 */\npub struct Token {}\nimpl Token {\nasync fn [[own-async:start]]own_async[[own-async:end]](self, zz_hidden: String) -> String { zz_hidden }\nfn [[own-sync:start]]own_sync[[own-sync:end]](self, zz_hidden: String) -> String { zz_hidden }\n}\npub trait Worker {\nasync fn [[trait-own-async:start]]own_async[[trait-own-async:end]](self, zz_hidden: String) -> String;\nfn [[trait-own-sync:start]]own_sync[[trait-own-sync:end]](self, zz_hidden: String) -> String { zz_hidden }\n}\npub async fn [[work-async:start]]work_async[[work-async:end]](zz_hidden: String) -> String { zz_hidden }\npub fn [[work-sync:start]]work_sync[[work-sync:end]](zz_hidden: String) -> String { zz_hidden }\n",
