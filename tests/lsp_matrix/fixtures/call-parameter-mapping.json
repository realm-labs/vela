    "vela.toml": "[package]\nid = \"dev.vela.ordinary_calls\"\nname = \"ordinary_calls\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n",
    "schema.json": "{\"formatVersion\":4,\"facts\":{\"types\":[{\"name\":\"host::Context\",\"fact\":{\"kind\":\"record\",\"name\":\"host::Context\"}},{\"name\":\"host::Reply\",\"fact\":{\"kind\":\"record\",\"name\":\"host::Reply\"}},{\"name\":\"host::Failure\",\"fact\":{\"kind\":\"enum\",\"name\":\"host::Failure\",\"variant\":null}}],\"functions\":[{\"name\":\"host::grant\",\"fact\":{\"kind\":\"function\",\"params\":[{\"kind\":\"primitive\",\"name\":\"u32\"},{\"kind\":\"primitive\",\"name\":\"bool\"},{\"kind\":\"primitive\",\"name\":\"string\"}],\"returns\":{\"kind\":\"primitive\",\"name\":\"bool\"}},\"signature\":{\"parameters\":[{\"name\":\"count\",\"typeFact\":{\"kind\":\"primitive\",\"name\":\"u32\"},\"requirement\":\"required\"},{\"name\":\"flag\",\"typeFact\":{\"kind\":\"primitive\",\"name\":\"bool\"},\"requirement\":\"required\"},{\"name\":\"reason\",\"typeFact\":{\"kind\":\"primitive\",\"name\":\"string\"},\"requirement\":\"defaulted\"}],\"returns\":{\"kind\":\"primitive\",\"name\":\"bool\"}}}]}}",
    "scripts/api.vela": "pub fn grant(count: i64, flag: bool, reason: String = \"x\") -> bool { return true; }\npub fn empty() -> bool { return true; }\npub struct Player {}\nimpl Player { fn grant(self, count: i64, flag: bool, reason: String = \"x\") -> bool { return true; } }\npub enum State { Ready(arg0: i64, arg1: String) }\n",
    "scripts/named_last.vela": "/* 中😀 */ fn main() { api::grant(reason = [[cursor]]); }\n",
    "scripts/named_middle.vela": "/* 中😀 */ fn main() { api::grant(flag = [[cursor]]); }\n",
    "scripts/named_first_after_last.vela": "/* 中😀 */ fn main() { api::grant(reason = \"x\", count = [[cursor]]); }\n",
    "scripts/named_last_after_first.vela": "/* 中😀 */ fn main() { api::grant(count = 1, reason = [[cursor]]); }\n",
    "scripts/empty_after_last.vela": "/* 中😀 */ fn main() { api::grant(reason = \"x\", [[cursor]]); }\n",
    "scripts/empty_after_middle.vela": "/* 中😀 */ fn main() { api::grant(flag = true, [[cursor]]); }\n",
    "scripts/empty_mixed.vela": "/* 中😀 */ fn main() { api::grant(1, reason = \"x\", [[cursor]]); }\n",
    "scripts/empty_all_used.vela": "/* 中😀 */ fn main() { api::grant(1, flag = true, reason = \"x\", [[cursor]]); }\n",
    "scripts/default_remaining.vela": "/* 中😀 */ fn main() { api::grant(1, true, [[cursor]]); }\n",
    "scripts/empty_start.vela": "/* 中😀 */ fn main() { api::grant([[cursor]]); }\n",
    "scripts/positional_second.vela": "/* 中😀 */ fn main() { api::grant(1, [[cursor]]); }\n",
    "scripts/positional_overflow.vela": "/* 中😀 */ fn main() { api::grant(1, true, \"x\", 4[[cursor]]); }\n",
    "scripts/unknown_name.vela": "/* 中😀 */ fn main() { api::grant(missing = [[cursor]]); }\n",
    "scripts/duplicate_name.vela": "/* 中😀 */ fn main() { api::grant(flag = true, flag = [[cursor]]); }\n",
    "scripts/duplicate_positional.vela": "/* 中😀 */ fn main() { api::grant(1, count = [[cursor]]); }\n",
    "scripts/positional_after_named.vela": "/* 中😀 */ fn main() { api::grant(flag = true, 1[[cursor]]); }\n",
    "scripts/identifier_after_named.vela": "/* 中😀 */ fn main() { api::grant(flag = true, chosen[[cursor]]); }\n",
    "scripts/known_after_unknown.vela": "/* 中😀 */ fn main() { api::grant(missing = 1, reason = [[cursor]]); }\n",
    "scripts/empty_after_unknown.vela": "/* 中😀 */ fn main() { api::grant(missing = 1, [[cursor]]); }\n",
    "scripts/empty_with_following_named.vela": "/* 中😀 */ fn main() { api::grant([[cursor]], count = 1); }\n",
    "scripts/empty_between_named.vela": "/* 中😀 */ fn main() { api::grant(reason = \"x\", [[cursor]], count = 1); }\n",
    "scripts/current_before_duplicate.vela": "/* 中😀 */ fn main() { api::grant(flag = [[cursor]], flag = false); }\n",
    "scripts/inside_named_token.vela": "/* 中😀 */ fn main() { api::grant(rea[[cursor]]son = \"x\"); }\n",
    "scripts/after_equal_comment.vela": "/* 中😀 */ fn main() { api::grant(reason = /* a,b */ [[cursor]]); }\n",
    "scripts/after_nested.vela": "/* 中😀 */ fn main() { api::grant(count = api::grant(1, true), reason = [[cursor]]); }\n",
    "scripts/nested_inner.vela": "/* 中😀 */ fn main() { api::grant(reason = api::grant(flag = [[cursor]])); }\n",
    "scripts/comma_in_string.vela": "/* 中😀 */ fn main() { api::grant(reason = \"a,b\", flag = [[cursor]]); }\n",
    "scripts/missing_close.vela": "/* 中😀 */ fn main() { api::grant(reason = \"x\", flag = [[cursor]]",
    "scripts/zero_empty.vela": "/* 中😀 */ fn main() { api::empty([[cursor]]); }\n",
    "scripts/zero_named.vela": "/* 中😀 */ fn main() { api::empty(count = [[cursor]]); }\n",
    "scripts/source_method.vela": "/* 中😀 */ fn main(p: api::Player) { p.grant(reason = \"x\", flag = [[cursor]]); }\n",
    "scripts/schema_named.vela": "/* 中😀 */ fn main() { host::grant(reason = [[cursor]]); }\n",
    "scripts/schema_mixed.vela": "/* 中😀 */ fn main() { host::grant(1, reason = \"x\", [[cursor]]); }\n",
    "scripts/schema_alias.vela": "/* 中😀 */ use host::grant as issue; fn main() { issue(reason = \"x\", count = [[cursor]]); }\n",
    "scripts/stdlib_named.vela": "/* 中😀 */ fn main() { math::max(right = [[cursor]]); }\n",
    "scripts/service_named_rejected.vela": "/* 中😀 */ fn handle(amount: i64, reason: String) { service::base::handle(reason = [[cursor]]); }\n",
    "scripts/service_positional.vela": "/* 中😀 */ fn handle(amount: i64, reason: String) { service::base::handle(1, [[cursor]]); }\n",
    "scripts/service_receiver_named.vela": "/* 中😀 */ fn main(peer: api::Peer) { peer.take(amount = [[cursor]]); }\n",
    "scripts/enum_named_rejected.vela": "/* 中😀 */ fn main() { api::State::Ready(arg1 = [[cursor]]); }\n",
    "scripts/enum_positional.vela": "/* 中😀 */ fn main() { api::State::Ready(1, [[cursor]]); }\n",
    "scripts/multiline.vela": "/* 中😀 */ fn main() { api::grant(\n reason = \"a,b\",\n /* 雪😀 */ flag = [[cursor]]); }\n",
    "scripts/nested_lambda.vela": "/* 中😀 */ fn main() { api::grant(count = apply(|left, right| left), reason = [[cursor]]); }\n",
    "scripts/missing_earlier_positional.vela": "/* 中😀 */ fn main() { api::grant(, true, [[cursor]]); }\n",
    "scripts/missing_before_named.vela": "/* 中😀 */ fn main() { api::grant(, reason = \"x\", [[cursor]]); }\n"
