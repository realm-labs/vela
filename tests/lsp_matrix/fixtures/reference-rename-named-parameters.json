    "vela.toml": "[package]\nid = \"dev.vela.named_parameters\"\nname = \"named_parameters\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "scripts/helpers.vela": "/* 中😀 */ pub fn grant([[parameter-decl:start]]amount[[parameter-decl:end]]: i64, bonus: i64 = 0) -> i64 { return [[parameter-read:start]]amount[[parameter-read:end]] + bonus; }\n",
    "scripts/consumer.vela": "/* 中😀 */ pub fn grant([[other-decl:start]]amount[[other-decl:end]]: i64) -> i64 { return [[other-read:start]]amount[[other-read:end]]; }\nfn side() { helpers::grant([[closed-label:start]]amount[[closed-label:end]] = 3); }\nfn default_call(seed: i64 = helpers::grant([[default-label:start]]amount[[default-label:end]] = 4)) {}\n",
    "scripts/main.vela": "use helpers::grant as reward\n/* 中😀 */ fn main([[caller-decl:start]]amount[[caller-decl:end]]: i64) {\n    reward([[alias-label:start]]amount[[alias-label:end]] = [[caller-read:start]]amount[[caller-read:end]]);\n    /* 中😀 */ helpers::grant([[qualified-label:start]]amount[[qualified-label:end]] = 2, bonus = 1);\n    consumer::grant([[other-label:start]]amount[[other-label:end]] = 3);\n    let callback = || reward([[lambda-label:start]]amount[[lambda-label:end]] = 4);\n    reward(5);\n    reward([[unknown-label:start]]bogus[[unknown-label:end]] = 6);\n    missing([[unknown-callee-label:start]]amount[[unknown-callee-label:end]] = 7);\n    let note = \"[[literal:start]]amount[[literal:end]]\";\n}\nfn incomplete() { reward([[recovery-label:start]]amount[[recovery-label:end]] = ); }\n"
  },
