    "vela.toml": "[package]\nid = \"dev.vela.schema_variants\"\nname = \"schema_variants\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"target/schema.json\"\n",
    "scripts/helpers.vela": "/* 中😀 */ pub fn [[decl:start]]Active[[decl:end]]() {}\n",
    "scripts/main.vela": "fn main() {\n /* 中😀 */ match host::State::[[scrutinee:start]]Active[[scrutinee:end]] { host::State::[[inline-pattern:start]]Active[[inline-pattern:end]] => { let next = host::State::[[arm-value:start]]Active[[arm-value:end]]; } peer::State::[[peer-pattern:start]]Active[[peer-pattern:end]] => {} }\n match peer::State::[[peer-value:start]]Active[[peer-value:end]] {\n host::State::[[split-pattern:start]]Active[[split-pattern:end]]\n => {}\n }\n let value = host::State::[[comment-value:start]]Active[[comment-value:end]]; // => [[comment:start]]Active[[comment:end]]\n let unknown = missing::State::[[unknown:start]]Active[[unknown:end]];\n let text = \"[[literal:start]]Active[[literal:end]] =>\";\n}\n",
    "scripts/consumer.vela": "fn closed() { let v = host::State::[[closed:start]]Active[[closed:end]];\n match meta::State::[[meta-value:start]]Active[[meta-value:end]] { meta::State::[[meta-pattern:start]]Active[[meta-pattern:end]] => {} }\n}\n",
    "scripts/imports.vela": "use host as bridge;\nuse host::State as Status;\nuse host::State::[[direct-import:start]]Active[[direct-import:end]];\nuse host::State::[[alias-path:start]]Active[[alias-path:end]] as [[alias-decl:start]]Selected[[alias-decl:end]];\nuse meta::State as Metadata;\nfn imported() {\n let a = bridge::State::[[module-value:start]]Active[[module-value:end]];\n match Status::[[enum-value:start]]Active[[enum-value:end]] { Status::[[enum-pattern:start]]Active[[enum-pattern:end]] => {} }\n let b = [[direct-value:start]]Active[[direct-value:end]];\n let c = [[alias-value:start]]Selected[[alias-value:end]];\n let d = Metadata::[[meta-alias:start]]Active[[meta-alias:end]];\n}\nfn source_owner() { let x = shadow::State::[[source-qualified:start]]Active[[source-qualified:end]]; }\nfn local_alias([[local-decl:start]]Selected[[local-decl:end]]) { let x = [[local-value:start]]Selected[[local-value:end]]; }\n",
    "scripts/shadow.vela": "pub enum State { [[source-decl:start]]Active[[source-decl:end]], Done }\nfn own() { let x = State::[[source-value:start]]Active[[source-value:end]]; match x { State::[[source-pattern:start]]Active[[source-pattern:end]] => {} } }\n"
  },
