    "scripts/main.vela": "use types::consume;\nuse types::Remote as Imported;\npub struct [[cell:start]]Cell[[cell:end]] { value: i64 }\npub const [[base:start]]BASE[[base:end]] = 4;\nstate [[counter:start]]counter[[counter:end]] = 0;\nextern state [[external:start]]external[[external:end]]: i64;\npub fn [[factory:start]]factory[[factory:end]]([[parameter:start]]amount[[parameter:end]]: i64 = 1) -> Cell {\n    return Cell { value: [[parameter-use]]amount };\n}\nfn main([[typed-parameter:start]]cell[[typed-parameter:end]]: [[type-hint]]Cell) {\n    let [[outer:start]]local[[outer:end]] = 7;\n    { let [[inner:start]]local[[inner:end]] = 9; [[inner-use]]local; }\n    let [[callback:start]]callback[[callback:end]] = || [[capture]]local;\n    let [[typed-local:start]]item[[typed-local:end]]: Cell = [[factory-use]]factory([[named-argument]]amount = 2);\n    let text = \"中😀\"; [[outer-use]]local;\n    [[base-use]]BASE + [[state-use]]counter + [[extern-use]]external;\n    [[typed-parameter-use]]cell;\n    [[typed-local-use]]item;\n    [[callback-use]]callback();\n    [[unknown]]missing_name;\n    [[keyword]]return;\n}\nfn types(local: [[builtin-hint]]i64, missing: [[missing-hint]]Missing, remote: [[alias-hint]]Imported, nested: Option<[[nested-hint]]Cell>) -> [[return-hint]]Cell { return Cell { value: 1 }; }\nfn accept([[record-parameter:start]]record[[record-parameter:end]]: Cell) {}\nfn labels(dynamic) {\n    let amount = 0;\n    let record = 0;\n    factory([[shadow-label]]amount = 3);\n    accept([[record-label]]record = Cell { value: 1 });\n    factory([[invalid-label]]unknown = 2);\n    dynamic([[dynamic-label]]amount = 2);\n    missing([[missing-label]]record = 3);\n    { let factory = dynamic; factory([[shadow-callee-label]]amount = 2); }\n}\nfn qualified(a: types::[[qualified-hint]]Remote, b: types::[[private-hint]]Hidden, c: [[module-hint]]types::Remote) {}\nfn Missing() -> Cell { return Cell { value: 1 }; }\nfn shadow_type() { let Cell = 1; let item: [[shadow-type-hint]]Cell = 2; }\nfn imported_label() { consume([[imported-label]]remote = Imported { value: 1 }); }\nenum [[choice:start]]Choice[[choice:end]] { One }\ntrait [[reader:start]]Reader[[reader:end]] { fn read(self) -> i64; }\nstruct Holder { item: [[field-hint]]Cell }\nfn kinds(a: [[enum-hint]]Choice, b: [[trait-hint]]Reader) {}\n",
