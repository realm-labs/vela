    "deps/hidden/vela.toml": "[package]\nid = \"dev.vela.hidden\"\nname = \"hidden\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "schema.json": "{\"formatVersion\":4,\"facts\":{\"types\":[{\"name\":\"api::Returned\",\"fact\":{\"kind\":\"record\",\"name\":\"api::Returned\"}}],\"fields\":[{\"owner\":\"api::Returned\",\"name\":\"foreign_schema\",\"fact\":{\"kind\":\"primitive\",\"name\":\"String\"},\"docs\":\"Wrong schema owner 中😀.\"}]}}",
    "scripts/api.vela": {"sourceFile": "sources/completion/completion-abrupt-flow-files-scripts-api.vela"},
    "deps/external/scripts/api.vela": {"sourceFile": "sources/completion/completion-abrupt-flow-files-deps-external-scripts-api.vela"},
    "deps/hidden/scripts/api.vela": {"sourceFile": "sources/completion/completion-abrupt-flow-files-deps-hidden-scripts-api.vela"},
    "scripts/return_tail.vela": "/* 中😀 */\nfn run(flag: bool) { ({ return; api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/return_nested.vela": "/* 中😀 */\nfn run(flag: bool) { ({ { return; } api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/return_both_branches.vela": "/* 中😀 */\nfn run(flag: bool) { ({ if flag { return; } else { return; } api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/return_one_branch.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { return; api::produce() } else { external::api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/return_reverse_branch.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { external::api::produce() } else { return; api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/return_match.vela": "/* 中😀 */\nfn run(flag: bool) { (match flag { true => { return; api::produce() }, _ => external::api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/fallthrough_after_conditional.vela": "/* 中😀 */\nfn run(flag: bool) { ({ if flag { return; } external::api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/break_tail.vela": "/* 中😀 */\nfn run(flag: bool) { for item in [1] { ({ break; api::produce() }).[[replace:start]][[cursor]][[replace:end]]; } }\n",
    "scripts/break_branch.vela": "/* 中😀 */\nfn run(flag: bool) { for item in [1] { (if flag { break; api::produce() } else { external::api::produce() }).[[replace:start]][[cursor]][[replace:end]]; } }\n",
    "scripts/continue_tail.vela": "/* 中😀 */\nfn run(flag: bool) { for item in [1] { ({ continue; api::produce() }).[[replace:start]][[cursor]][[replace:end]]; } }\n",
    "scripts/continue_branch.vela": "/* 中😀 */\nfn run(flag: bool) { for item in [1] { (if flag { continue; api::produce() } else { external::api::produce() }).[[replace:start]][[cursor]][[replace:end]]; } }\n",
    "scripts/lambda_return.vela": "/* 中😀 */\nfn run(flag: bool) { (|| { return api::produce(); external::api::produce() })().[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/lambda_conditional_return.vela": "/* 中😀 */\nfn run(flag: bool) { (|| { if flag { return api::produce(); } api::produce() })().[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/lambda_bare_return.vela": "/* 中😀 */\nfn run(flag: bool) { (|| { return; api::produce() })().[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/lambda_loop_return.vela": "/* 中😀 */\nfn run(flag: bool) { (|| { for item in [1] { return api::produce(); external::api::produce(); } api::produce() })().[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/return_in_expression.vela": "/* 中😀 */\nfn run(flag: bool) { ({ ({ return; }); api::produce() }).[[replace:start]][[cursor]][[replace:end]]; }\n",
    "scripts/lambda_nested_return.vela": "/* 中😀 */\nfn run(flag: bool) { (|| { ({ return api::produce(); }); external::api::produce() })().[[replace:start]][[cursor]][[replace:end]]; }\n"
