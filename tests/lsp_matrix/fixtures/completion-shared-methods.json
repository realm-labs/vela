  "id": "completion-shared-methods",
  "files": {
    "vela.toml": "[package]\nid = \"dev.vela.type_aliases\"\nname = \"type_aliases\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[host]\nschema = \"schema.json\"\n[dependencies]\nexternal = { path = \"deps/external\" }\n",
    "deps/external/vela.toml": "[package]\nid = \"dev.vela.external\"\nname = \"external\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n[dependencies]\nhidden = { path = \"../hidden\" }\n",
    "deps/hidden/vela.toml": "[package]\nid = \"dev.vela.hidden\"\nname = \"hidden\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "schema.json": "{\"formatVersion\":1,\"facts\":{\"types\":[{\"name\":\"api::Token\",\"fact\":{\"kind\":\"record\",\"name\":\"api::Token\"}}],\"fields\":[{\"owner\":\"api::Token\",\"name\":\"own_schema\",\"fact\":{\"kind\":\"primitive\",\"name\":\"String\"},\"docs\":\"Wrong schema owner 中😀.\"}],\"methods\":[{\"owner\":\"api::Token\",\"name\":\"zz_pick\",\"fact\":{\"kind\":\"function\",\"params\":[{\"kind\":\"primitive\",\"name\":\"String\"}],\"returns\":{\"kind\":\"primitive\",\"name\":\"String\"}}}]}}",
    "scripts/api.vela": "/* 中😀 */\npub struct Token {}\nimpl Token { fn [[pick:start]]zz_pick[[pick:end]](self, zz_root: i64) -> i64 { zz_root } fn [[next:start]]zz_next[[next:end]](self) -> Token { Token {} } }\npub trait Reader { fn [[default:start]]zz_default[[default:end]](self, zz_root: i64) -> i64 { 1 } }\nimpl Reader for Token {}\npub fn produce() -> Token { Token {} }\npub fn erase() -> Any { () }\npub struct Holder { item: Token }\npub fn wrap() -> Holder { Holder { item: Token {} } }\n",
    "deps/external/scripts/api.vela": "/* 中😀 */\npub struct Token {}\nimpl Token { fn [[pick:start]]zz_pick[[pick:end]](self, zz_dep: bool) -> bool { zz_dep } fn [[next:start]]zz_next[[next:end]](self) -> Token { Token {} } }\npub trait Reader { fn [[default:start]]zz_default[[default:end]](self, zz_dep: bool) -> bool { true } }\nimpl Reader for Token {}\npub fn produce() -> Token { Token {} }\npub fn erase() -> Any { () }\n",
    "deps/hidden/scripts/api.vela": "/* 中😀 */\npub struct Token {}\nimpl Token { fn [[pick:start]]zz_pick[[pick:end]](self, zz_hidden: String) -> String { zz_hidden } fn [[next:start]]zz_next[[next:end]](self) -> Token { Token {} } }\npub trait Reader { fn [[default:start]]zz_default[[default:end]](self, zz_hidden: String) -> String { \"hidden\" } }\nimpl Reader for Token {}\npub fn produce() -> Token { Token {} }\npub fn erase() -> Any { () }\n",
    "scripts/root.vela": "/* 中😀 */\nfn run(flag: bool) { api::produce().[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/dependency.vela": "/* 中😀 */\nfn run(flag: bool) { external::api::produce().[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/joined.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { api::produce() } else { external::api::produce() }).[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/reversed.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { external::api::produce() } else { api::produce() }).[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/local_join.vela": "/* 中😀 */\nfn run(flag: bool) { let selected = if flag { api::produce() } else { external::api::produce() }; selected.[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/match_join.vela": "/* 中😀 */\nfn run(flag: bool) { (match flag { true => api::produce(), _ => external::api::produce() }).[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/branch_write.vela": "/* 中😀 */\nfn run(flag: bool) { let selected = api::produce(); if flag { selected = external::api::produce(); } selected.[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/overwrite.vela": "/* 中😀 */\nfn run(flag: bool) { let selected = if flag { api::produce() } else { external::api::produce() }; selected = external::api::produce(); selected.[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/prior_alias.vela": "/* 中😀 */\nfn run(flag: bool) { let selected = api::produce(); let prior = selected; selected = external::api::produce(); prior.[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/joined_return.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { api::produce() } else { external::api::produce() }).zz_next().[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/erased_join.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { api::produce() } else { api::erase() }).[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/missing_return.vela": "/* 中😀 */\nfn run(flag: bool) { api::produce().missing().[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/erased.vela": "/* 中😀 */\nfn run() { api::erase().[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/erased_reversed.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { api::erase() } else { api::produce() }).[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/erased_match.vela": "/* 中😀 */\nfn run(flag: bool) { (match flag { true => api::produce(), _ => api::erase() }).[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/erased_return.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { api::wrap() } else { api::erase() }).item.zz_next().[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/erased_field.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { api::wrap() } else { api::erase() }).item.[[replace:start]]zz_[[cursor]][[replace:end]]; }\n",
    "scripts/unknown_erased_return.vela": "/* 中😀 */\nfn run(flag: bool) { (if flag { api::produce() } else { api::erase() }).zz_next().[[replace:start]]zz_[[cursor]][[replace:end]]; }\n"
  },
