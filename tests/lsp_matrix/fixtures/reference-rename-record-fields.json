    "vela.toml": "[package]\nid = \"dev.vela.record_fields\"\nname = \"record_fields\"\nversion = \"0.1.0\"\n[source]\nroots = [\"scripts\"]\n",
    "scripts/helpers.vela": "/* 中😀 */ pub struct Record { [[field-decl:start]]value[[field-decl:end]]: i64, spare: i64 }\n",
    "scripts/consumer.vela": "/* 中😀 */ pub struct Record { [[other-decl:start]]value[[other-decl:end]]: i64 }\nfn closed() { let x = helpers::Record { [[closed-label:start]]value[[closed-label:end]]: 3, spare: 0 }; }\nfn other([[other-param:start]]value[[other-param:end]]: i64) { let x = Record { [[other-shorthand:start]]value[[other-shorthand:end]] }; return x.[[other-read:start]]value[[other-read:end]]; }\n",
    "scripts/main.vela": "use helpers::Record as Alias\n/* 中😀 */ fn main([[main-param:start]]value[[main-param:end]]: i64) {\n let x = Alias { [[alias-label:start]]value[[alias-label:end]]: value, spare: 0 };\n let y = helpers::Record { [[qualified-shorthand:start]]value[[qualified-shorthand:end]], spare: 1 };\n x.[[dot-read:start]]value[[dot-read:end]];\n x.[[dot-write:start]]value[[dot-write:end]] = 2;\n x.[[dot-compound:start]]value[[dot-compound:end]] += 1;\n match x { Alias { [[pattern-label:start]]value[[pattern-label:end]]: extracted, spare: _ } => extracted };\n match y { helpers::Record { [[pattern-shorthand:start]]value[[pattern-shorthand:end]], spare: _ } => [[pattern-body:start]]value[[pattern-body:end]] };\n let other = consumer::Record { [[other-label:start]]value[[other-label:end]]: 9 };\n let note = \"[[literal:start]]value[[literal:end]]\";\n}\nfn invalid() { helpers::Record { [[unknown-label:start]]bogus[[unknown-label:end]]: 4 }; Missing { [[unknown-owner:start]]value[[unknown-owner:end]]: 7 }; }\n"
  },
