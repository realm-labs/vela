
            struct Reward {
                enabled: bool,
                base: int,
                multiplier: int,
            }

            fn score_reward(reward) {
                if !reward.enabled {
                    return 0;
                }
                return reward.base * reward.multiplier;
            }

            fn main() {
                let reward = Reward {
                    enabled: true,
                    base: 12,
                    multiplier: 3,
                };
                return score_reward(reward) + 4;
            }
            