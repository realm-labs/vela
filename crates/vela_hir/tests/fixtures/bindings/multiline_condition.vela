
fn expect_i64(value: i64) {
    return value;
}

fn expect_i8(value: i8) {
    return value;
}

fn main() {
    let default_integer = 12;
    let contextual: i8 = 7;
    let score: i64 = if expect_i64(default_integer) == 12
        && expect_i8(contextual) == 7i8
    {
        19
    } else {
        0
    };
    return score;
}
