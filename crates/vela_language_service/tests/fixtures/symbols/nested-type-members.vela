const BASE: i64 = 1
state player: Player = Player { level: 1, name: "sample" };
pub struct Player {
    level: i64
    name: String
}
pub enum Reward {
    None
    Coins(amount: i64)
    Item { id: String }
}
pub trait Damageable {
    fn damage(amount: i64) -> bool
}
impl Player {
    fn heal(amount: i64) -> i64 { return amount }
}
pub fn main(amount: i64) -> i64 { return amount }