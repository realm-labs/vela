
trait BonusSource { fn bonus(self, amount) -> i64; }
struct Player { level: i64 }

impl BonusSource for Player {
    fn bonus(self, amount) -> i64 {
        return self.level + amount;
    }
}

fn add_bonus(value) {
    return value + 5;
}

fn main() {
    let player = Player { level: 7 };
    return add_bonus(player.bonus(4));
}
