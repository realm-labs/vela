
trait BonusSource {
    fn score(self, amount, multiplier = 2) -> i64;
}

struct Reward {
    gold: i64,
}

impl BonusSource for Reward {
    fn score(self, amount, multiplier = 2) -> i64 {
        return self.gold + amount * multiplier;
    }
}

fn make_reward() {
    return Reward { gold: 7 };
}
