
struct ServerState {
    level: i64,
    name: String,
}

state state: ServerState = ServerState { level: 0, name: "" };

fn make_state() {
    return ServerState { level: 5, name: "boot" };
}

fn bump(amount) {
    state.level += amount;
    return state.level;
}

fn read_name() {
    return state.name;
}
