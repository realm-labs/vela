
enum Damage {
    Physical { amount: i64 },
    Magical { amount: i64 },
}

fn main() {
    let damage = Damage::Physical { amount: 7 };
    match damage {
        Damage::Magical { amount } => { return amount + 100; },
        Damage::Physical { amount } => { return amount + 1; },
        _ => { return 0; },
    }
}
