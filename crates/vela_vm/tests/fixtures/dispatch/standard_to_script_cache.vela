
struct Label {
    text: String,
}

impl Label {
    fn starts_with(self, prefix: String) -> bool {
        return self.text.starts_with(prefix);
    }
}

fn main(use_label, text) {
    let value = if use_label {
        Label { text: text }
    } else {
        text
    };
    return value.starts_with("q");
}
