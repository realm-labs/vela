
fn receiver(values, trace) {
    trace.push(1);
    return values;
}

fn index(trace) {
    trace.push(2);
    return 0;
}

fn aliasing_value(values, trace) {
    trace.push(3);
    values[0] = 100;
    return 5;
}

fn main() {
    let values = [10];
    let trace = [];
    receiver(values, trace)[index(trace)] += aliasing_value(values, trace);
    return [values[0], trace.len(), trace[0], trace[1], trace[2]];
}
