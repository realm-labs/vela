
fn main() {
    let iter = [1, 2, 3, 4, 5].iter();
    let pipeline = iter
        .filter(|value| value > 1)
        .map(|value| value * 10)
        .skip(1)
        .take(2);
    let total = 0;
    for value in pipeline {
        total += value;
    }
    let exhausted = iter.next().unwrap_or(99);
    return total * 100 + exhausted;
}
