
fn main() {
    let total = 0;
    for value in [2, 3, 5].iter() {
        total += value;
    }
    for entry in {"gold": 7, "xp": 11}.iter() {
        total += entry.value;
    }
    for value in (1..4).iter() {
        total += value;
    }
    for ch in "a奖励".chars() {
        if ch == 'a' {
            total += 100;
        }
        if ch == '奖' {
            total += 1000;
        }
        if ch == '励' {
            total += 10000;
        }
    }
    for byte in "AZ".bytes() {
        total += 1;
    }
    return total;
}
