
struct Label {
    text: String,
}

impl Label {
    fn starts_with(self, prefix: String) -> bool {
        return self.text.starts_with(prefix);
    }
}

fn matches_prefix(value) {
    return value.starts_with("q");
}

fn main() {
    let total = 0;
    for tick in 0..128 {
        let label = Label { text: "quest" };
        if matches_prefix(label) {
            total += tick + 1;
        }
    }
    return total;
}
