
fn main() {
    let total = 0;
    for tick in 0..96 {
        let tags = ["daily", "quest", "raid", "bonus", "event", "boss"];
        let scores = {
            "daily": 3,
            "raid": 8,
            "boss": 13,
            "event": 5,
        };
        if tags.contains("raid")
            && scores.has("boss")
            && tags.any(|tag| tag.starts_with("q"))
            && scores.get_or("missing", tick - tick) == 0
        {
            total += tags.len() + scores.get_or("daily", 0);
        }
    }
    return total;
}
