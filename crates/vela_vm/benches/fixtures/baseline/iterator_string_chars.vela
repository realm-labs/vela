
fn main() {
    let total = 0;
    for tick in 0..96 {
        let count = 0;
        let bonus = 0;
        for ch in "vela奖励hot".chars() {
            count += 1;
            if ch == '奖' {
                bonus += 10;
            }
        }
        if count != 9 || bonus != 10 {
            return 0;
        }
        total += count + bonus + tick - tick;
    }
    return total;
}
