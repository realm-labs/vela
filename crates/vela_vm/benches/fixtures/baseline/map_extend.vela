
fn main() {
    let total = 0;
    for tick in 0..96 {
        let scores = {
            "daily": 3,
            "raid": 8,
        };
        let patch = {
            "raid": 21,
            "boss": 13,
            "event": 5,
        };
        scores.extend(patch);
        scores.extend({"bonus": 34});

        if scores.len() != 5
            || scores["daily"] != 3
            || scores["raid"] != 21
            || scores["event"] != 5
            || scores["bonus"] != 34
        {
            return 0;
        }
        total += scores.len() + scores["raid"] + tick - tick;
    }
    return total;
}
