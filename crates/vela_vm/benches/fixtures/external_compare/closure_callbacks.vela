
fn run_once() {
    let total = 0;
    for tick in 0..120 {
        let add = |value: i64| value + tick;
        let mix = |left: i64, right: i64| left * 3 + right + tick - tick;
        total += add(tick);
        total += add(total % 17);
        total += mix(tick, total % 23);
    }
    return total;
}

fn main(iterations: i64) {
    let checksum = 0;
    for iteration in 0..iterations {
        checksum += run_once();
    }
    return checksum;
}
