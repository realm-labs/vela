
struct Counter {
    value,
    step,
}

impl Counter {
    fn bump(self, extra) {
        return self.value + self.step + extra;
    }
}

fn run_once() {
    let total = 0;
    for tick in 0..96 {
        let counter = Counter { value: tick, step: tick % 5 + 1 };
        total += counter.bump(tick % 3);
        total += counter.value + counter.step;
    }
    return total;
}

fn main(iterations: i64) {
    let checksum = 0;
    for iteration in 0..iterations {
        checksum += run_once();
    }
    return checksum;
}
