
fn run_once() {
    let total = 0;
    for tick in 0..72 {
        let text = "alpha,beta,gamma,delta";
        let parts = text.split(",");
        let joined = parts.join(":");
        total += joined.len() + 10 + tick % 11;
    }
    return total;
}

fn main(iterations: i64) {
    let checksum = 0;
    for iteration in 0..iterations {
        checksum += run_once();
    }
    return checksum;
}
