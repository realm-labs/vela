
fn run_once() {
    let total = 0;
    for tick in 0..96 {
        let active = set::from_array(["quest", "raid"]);
        active.add("event");
        active.add("quest");
        active.remove("raid");
        if active.has("quest") && active.has("event") && !active.has("raid") {
            total += active.len() + tick % 7;
        }
    }
    return total;
}

fn main(iterations: i64) {
    let checksum = 0;
    for iteration in 0..iterations {
        checksum += run_once();
    }
    return checksum;
}
