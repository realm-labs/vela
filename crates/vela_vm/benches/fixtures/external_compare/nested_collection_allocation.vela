
fn run_once() {
    let total = 0;
    for tick in 0..64 {
        let rows = [
            [tick, tick + 1, tick + 2],
            [tick + 3, tick + 4, tick + 5],
            [tick + 6, tick + 7, tick + 8],
        ];
        let labels = {
            "alpha": tick,
            "beta": tick + 2,
            "gamma": tick + 4,
        };
        total += rows[0][1] + rows[1][2] + rows[2][0];
        total += labels["alpha"] + labels["gamma"];
    }
    return total;
}

fn main(iterations: i64) {
    let checksum = 0;
    for iteration in 0..iterations {
        checksum += run_once();
    }
    return checksum;
}
