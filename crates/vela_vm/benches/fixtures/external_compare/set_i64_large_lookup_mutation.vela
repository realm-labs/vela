
fn run_once() {
    let active = set::from_array([]);
    for value in 0..64 {
        active.add(value);
    }
    let total = 0;
    for tick in 0..192 {
        active.add(64);
        active.remove(64);
        if active.has(0) && active.has(63) && !active.has(128) {
            total += active.len() + tick % 7;
        }
    }
    return total;
}

fn main(iterations: i64) {
    let checksum = 0;
    for iteration in 0..iterations {
        checksum += run_once();
    }
    return checksum;
}
