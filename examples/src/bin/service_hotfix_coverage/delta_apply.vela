#[service_impl(coverage::apply)]
impl ApplyDelta {
    fn apply(context, row, score) {
        service::base::apply(context, row, score)?;
        service::pinned::audit::record(context, score + 100);
        return Result::Ok(());
    }
}

#[service_impl(coverage::transform)]
impl TransformDelta {
    fn collections(context, values) {
        let transformed = values
            .filter(|value| value.amount >= 2)
            .map(|value| coverage::ValueRow {
                amount: value.amount + 1,
            });
        let shared = service::base::inspect(context, transformed);
        let owned = service::base::consume(context, transformed);
        return owned * 100 + shared;
    }

    fn buffer(context) {
        let buffer = PatchBuffer::new(7);
        let shared = service::base::inspect_buffer(context, buffer);
        service::base::update_buffer(context, buffer, 5);
        let updated = service::base::inspect_buffer(context, buffer);
        return shared * 100 + updated;
    }

    fn copyback(context, values) {
        let transformed = values.map(|value| value);
        return service::base::copyback(context, transformed);
    }
}
